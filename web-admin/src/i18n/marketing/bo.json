  "tierB.countries.columns.einvoicing": "གཞུང་གི་གློག་རྡུལ་ཚོང་འཛིན",
  "tierB.countries.einvoicingLive": "ང་ཚོས་ ZATCA ཡི་ Fatoora སྟེགས་བུ་དང་རིམ་པ་གཉིས་པའི་སྦྲེལ་མཐུད་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད",
  "tierB.countries.einvoicingOnRequest": "རེ་ཞུ་ལྟར་མཁོ་སྤྲོད",
  "tierB.countries.taxNote": "དངུལ་ལོར་དང་ཁྲལ་ཚད་ནི་ཀུང་སི་རེ་རེས་རང་གི་སྒྲིག་འགོད་ནང་གཏན་འཁེལ་བྱེད། རེའུ་མིག་འདིའི་ཁྲལ་ཚད་ནི་སྤྱིར་བཏང་གི་ལམ་སྟོན་ཁོ་ན་ཡིན་ལ་འགྱུར་བ་འགྲོ་སྲིད། ད་ལྟའི་སྒྲིག་གཞི་ཁྱེད་ཀྱི་ཁྲལ་འབབ་བློ་འདྲི་བར་ཞིབ་འདྲི་གནང་། ཐིག་ཕྲན (—) ནི་རྒྱལ་ཁབ་དེའི་སྤྱིར་བཏང་གི་ཚད་བཀོད་མེད་པའི་དོན་ཡིན།",
  "tierB.about.title": "FieldSales སྐོར།",
  "tierB.about.description": "FieldSales ཀྱིས་ཚོང་འཚོང་ངོ་ཚབ་ཡོད་པའི་བགོ་འགྲེམས་ཀུང་སིའི་ཆེད་དུ་སྤྲིན་རྩིས་མཉེན་ཆས་བཟོ། སྤྱི་ལོ་ 2026 ལོར་སའུ་དི་ཨ་རབ་ཀྱི་རི་ཡཱ་དྷར་བཙུགས།",
  "tierB.about.h1": "FieldSales སྐོར།",
  "tierB.about.body.0": "FieldSales (ཨ་རབ་སྐད་ཀྱི་མིང་ فيلد سيلز) ནི་ཚོང་འཚོང་ངོ་ཚབ་ཡོད་པའི་བགོ་འགྲེམས་དང་སྤྱི་ཚོང་ཀུང་སི་རྣམས་ཀྱི་ཆེད་དུ་བཟོས་པའི་སྤྲིན་རྩིས་སྟེགས་བུ་ཞིག་ཡིན། FieldSales ཀུང་སི་ནི་སྤྱི་ལོ་ 2026 ལོར་བཙུགས་ཤིང་དབུ་ཁང་སའུ་དི་ཨ་རབ་ཀྱི་རི་ཡཱ་དྷ་ན་ཡོད། དེས་རྒྱལ་ཁབ་ཚང་མའི་ཀུང་སི་ལ་ཞབས་ཞུ་སྒྲུབ་ཅིང་། རྒྱལ་ཁབ་རེ་རེའི་དངུལ་ལོར་དང་ཁྲལ་ཚད་ནི་ཀུང་སི་རེ་རེས་རང་གི་སྒྲིག་འགོད་ནང་གཏན་འཁེལ་བྱེད། ང་ཚོའི་མཁོ་མཁན་ནི་ལམ་ཐོག་གི་ངོ་ཚབ་བརྒྱུད་ནས་ཚོང་འཚོང་དང་སྐྱེལ་འདྲེན་བྱེད་པའི་ཀུང་སི་སྟེ། བགོ་འགྲེམས་པ་དང་སྤྱི་ཚོང་པ། རང་ཉིད་ཀྱི་ཚོང་འཚོང་རུ་ཁག་ཡོད་པའི་བཟོ་ལས་ཀུང་སི་བཅས་ཡིན།",
  "tierB.about.body.1": "ང་ཚོས་ལམ་ཐོག་ལས་ཀའི་བྱ་རིམ་ཆ་ཚང་གི་ཆེད་དུ་ཕན་ཚུན་སྦྲེལ་བའི་མ་ལག་གཅིག་བཟོས་ཡོད། དེའི་ནང་ངོ་ཚབ་ཀྱི་ཁ་པར་ནས་པར་འདེབས་བྱེད་པའི་ཚོང་འཛིན་དང་། དངུལ་ལེན་འཛིན་ཤོག་དང་ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ། རླངས་འཁོར་གྱི་ཚོང་ཟོག་འགན་འཁྲི། གནས་ས་དང་འདྲ་པར་ཅན་གྱི་འགྲོ་ལམ་དང་འཚམས་འདྲི། འགན་འཛིན་པའི་དྲ་ངོས་ལྟ་ཞིབ་ངོས་ལེབ་བཅས་ཚུད་ཡོད། ངོ་ཚབ་ཀྱི་ཉེར་སྤྱོད་མཉེན་ཆས་ Android དང་ iPhone ཐོག་བཀོལ་ཐུབ་ལ། དྲ་རྒྱ་མེད་ཀྱང་ལས་ཀ་བྱེད་ཅིང་དྲ་རྒྱ་བྱུང་རྗེས་མཉམ་འགྲིག་བྱེད། ཀུང་སི་རྣམས་ཀྱིས་རང་གི་རྩིས་ཁྲ་ཡང་ན་ ERP མ་ལག་དང་ FieldSales གཉིས་ API བརྒྱུད་ནས་སྦྲེལ་ཐུབ་པས། ལམ་ཐོག་གི་གཞི་གྲངས་ཐེངས་གཉིས་ནང་འཇུག་བྱེད་མི་དགོས།",
  "tierB.about.body.2": "ང་ཚོས་ཐོན་རྫས་ཇི་བཞིན་ངོ་སྤྲོད་བྱེད། ང་ཚོས་ ZATCA ཡི་ Fatoora སྟེགས་བུ་དང་རིམ་པ་གཉིས་པའི་སྦྲེལ་མཐུད་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད། རྒྱལ་ཁབ་གཞན་གྱི་གཞུང་གི་མ་ལག་དང་སྦྲེལ་མཐུད་ནི་རེ་ཞུ་ལྟར་མཁོ་སྤྲོད་ཐུབ། ཉེར་སྤྱོད་མཉེན་ཆས་ཀྱི་ངོས་ལེབ་ནི་ ཨ་རབ་ཡིག དབྱིན་ཡིག ཧྥ་རན་སི་ཡིག ཏུར་ཀི་ཡིག་དང་རྒྱ་ཡིག ཐོག་ཡོད། བོད་ཡིག་གི་ངོས་ལེབ་མེད། ང་ཚོ་དང་གླེང་མོལ་བྱེད་པར་རིན་གོང་དྲི་བའམ་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་འཇོག་པ། ཡང་ན་ WhatsApp ནང་འཕྲིན་ཐུང་གཏོང་རོགས།",
  "tierB.contact.title": "FieldSales དང་འབྲེལ་བ་གནང་།",
  "tierB.contact.description": "FieldSales རུ་ཁག་དང་གླེང་མོལ། ལམ་ཐོག་ཚོང་འཚོང་དང་རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས་སྐོར་རིན་གོང་དྲི་བ། ཐུག་འཕྲད་དུས་ཚོད་འཇོག་པ། ཡང་ན་ WhatsApp ནང་ཁ་བརྡ་གཏོང་བ།",
  "tierB.contact.h1": "FieldSales དང་འབྲེལ་བ་གནང་།",
  "tierB.contact.intro": "ད་ལྟ་ཁྱེད་ཀྱི་ངོ་ཚབ་ཚོས་ཇི་ལྟར་འཚོང་བ་དང་། ཁྱེད་ཀྱིས་ཅི་ཞིག་བསྒྱུར་འདོད་པ་ང་ཚོར་གསུངས། རིན་གོང་དྲི་བའམ་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་འཇོག་པ། ཡང་ན་ WhatsApp ནང་འཕྲིན་ཐུང་བཏང་ན་ང་ཚོའི་རུ་ཁག་གི་ཚོགས་མི་ཞིག་གིས་ལན་འདེབས་བྱེད་རྒྱུ་ཡིན། ད་ལྟའི་མཁོ་མཁན་ཚོས་ཀྱང་རོགས་རམ་ཆེད་ལམ་ཀ་འདི་དག་བེད་སྤྱོད་བྱེད་ཐུབ། ཁྱེད་ཀྱི་རྒྱལ་ཁབ་དང་ངོ་ཚབ་ཀྱི་གྲངས་འབོར། ཁོང་ཚོས་རླངས་འཁོར་ནས་འཚོང་ངམ་མངགས་ཉོ་ལེན་ནམ་གཉིས་ཀ་བྱེད་པ་བཅས་གསུངས་ན་ཕན་ཐོགས་ཡོད།",
  "tierB.contact.meetingIntro": "ང་ཚོའི་རུ་ཁག་དང་དྲ་ཐོག་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་འཇོག་རོགས། ང་ཚོས་ཁྱེད་ཀྱི་ཚོང་ཟོག་དང་འགྲོ་ལམ་དང་ཉེ་བའི་དཔེ་མཚོན་བེད་སྤྱོད་བྱས་ནས་ཉེར་སྤྱོད་མཉེན་ཆས་ནང་ངོ་ཚབ་ཀྱི་ཉིན་གཅིག་དང་འགན་འཛིན་པའི་ལྟ་ཞིབ་ངོས་ལེབ་སྟོན་རྒྱུ་ཡིན་ལ། སྒྲིག་འགོད་སྐོར་གྱི་དྲི་བར་ལན་འདེབས་བྱེད་རྒྱུ་ཡིན།"
 }
}
