 "strings": {
  "tierB.home.title": "FieldSales: རླངས་འཁོར་ནས་ཚོང་འཚོང་དང་ཚོང་འཚོང་ངོ་ཚབ་མཉེན་ཆས།",
  "tierB.home.description": "བགོ་འགྲེམས་མཉེན་ཆས། ངོ་ཚབ་ཀྱི་ཁ་པར་ནས་ཚོང་འཛིན་དང་དངུལ་ལེན་འཛིན་ཤོག རླངས་འཁོར་གྱི་ཚོང་ཟོག དངུལ་སྡུད། འགྲོ་ལམ། འཚམས་འདྲི། དྲ་མེད་བཀོལ་ཐུབ། རྗེས་སུ་མཉམ་འགྲིག",
  "tierB.home.h1": "ཐེངས་དང་པོའི་འཚམས་འདྲི་ནས་མཐའ་མའི་དངུལ་སྡུད་བར་ཁྱེད་ཀྱི་ཚོང་འཚོང་ངོ་ཚབ་ཚོའི་ལས་ཀ་དོ་དམ་གནང་།",
  "tierB.home.definition": "FieldSales ནི་ཚོང་འཚོང་ངོ་ཚབ་ཚོང་ཁང་ཁག་ལ་གཏོང་མཁན་གྱི་ཚོང་ཟོག་བགོ་འགྲེམས་དང་སྤྱི་ཚོང་ཀུང་སི་རྣམས་ཀྱི་ཆེད་དུ་བཟོས་པའི་རླངས་འཁོར་ནས་ཚོང་འཚོང་ (van sales) དང་ཚོང་འཚོང་ངོ་ཚབ་དོ་དམ་གྱི་སྤྲིན་རྩིས་སྟེགས་བུ་ཞིག་ཡིན། ཚོང་འཚོང་ངོ་ཚབ་ཚོས་རང་གི་ཁ་པར་ནས་ཚོང་འཛིན་དང་དངུལ་ལེན་འཛིན་ཤོག་བཟོ་སྟེ་པར་འདེབས་བྱེད། རླངས་འཁོར་གྱི་ཚོང་ཟོག་ལ་ལྟ་རྟོག་བྱེད། འཚམས་འདྲི་ཐོ་འགོད་བྱེད། འགན་འཛིན་པས་ཚོང་འཚོང་དང་དངུལ་སྡུད། ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ་བཅས་དུས་ཐོག་ཏུ་མཐོང་ཐུབ།",
  "tierB.home.capabilities.0.title": "ངོ་ཚབ་ཀྱི་ཁ་པར་ནས་ཚོང་འཛིན།",
  "tierB.home.capabilities.0.line": "ཚོང་འཚོང་ངོ་ཚབ་ཀྱིས་ཉོ་མཁན་གྱི་ཚོང་ཁང་དུ་ཚོང་འཛིན་བཟོ་ཞིང་། ཚོང་ཁང་ནས་མ་ཐོན་གོང་ Bluetooth ཚ་དྲོད་པར་འཕྲུལ་ཐོག་པར་འདེབས་བྱེད།",
  "tierB.home.capabilities.1.title": "དངུལ་སྡུད་དང་ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ།",
  "tierB.home.capabilities.1.line": "དངུལ་སྤྲོད་རེ་རེར་ཨང་རྟགས་ཅན་གྱི་དངུལ་ལེན་འཛིན་ཤོག་རེ་ཡོད་ལ། དེ་ནི་སྤྲོད་ཟིན་པའི་ཚོང་འཛིན་དང་འབྲེལ་ཡོད། ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ་དང་རྩིས་ཁྲ་མྱུར་དུ་གསར་བསྒྱུར་འགྱུར།",
  "tierB.home.capabilities.2.title": "རླངས་འཁོར་གྱི་ཚོང་ཟོག་འགན་འཁྲི།",
  "tierB.home.capabilities.2.line": "རླངས་འཁོར་རེ་རེའི་ཚོང་ཟོག་རིགས་རེ་རེ་བཞིན་བཀལ་བ་དང་། བཙོངས་པ། ཕྱིར་སློག ལྷག་མ་བཅས་རྩིས་འཛིན་བྱེད་པས། ཁྱད་པར་ཡོད་ན་ཉིན་དེ་ཉིད་ལ་མཐོང་ཐུབ།",
  "tierB.home.capabilities.3.title": "འགྲོ་ལམ་དང་འཚམས་འདྲི།",
  "tierB.home.capabilities.3.line": "འཚམས་འདྲི་རེ་རེ་གནས་ས་དང་དུས་ཚོད། འདྲ་པར་བཅས་དང་མཉམ་དུ་ཐོ་འགོད་བྱེད་ལ། འགན་འཛིན་པའི་ཆེད་དུ་ངོ་ཚབ་རེ་རེའི་འགྲོ་ལམ་ས་ཁྲའི་ཐོག་འགོད།",
  "tierB.home.capabilities.4.title": "དྲ་རྒྱ་མེད་ཀྱང་བཀོལ་ཐུབ།",
  "tierB.home.capabilities.4.line": "བརྡ་རྟགས་མེད་ཀྱང་ངོ་ཚབ་ཚོས་མུ་མཐུད་ཚོང་འཚོང་བྱེད་ཐུབ། ཡིག་ཆ་རྣམས་ཁ་པར་ནང་སྒུག་སྡོད་བྱེད་ཅིང་། དྲ་རྒྱ་བསྐྱར་དུ་བྱུང་རྗེས་བསྐྱར་ཟློས་མེད་པར་རང་འགུལ་གྱིས་མཉམ་འགྲིག་འགྱུར།",
  "tierB.home.capabilities.5.title": "འགན་འཛིན་པའི་དྲ་ངོས་ལྟ་ཞིབ་ངོས་ལེབ།",
  "tierB.home.capabilities.5.line": "ཚོང་འཚོང་། དངུལ་སྡུད། ཕྱིར་སློག ཚོང་ཟོག ངོ་ཚབ་ཀྱི་ལས་ཀའི་གྲུབ་འབྲས་བཅས་ས་གཅིག་ཏུ་ཡོད་ལ། བེད་སྤྱོད་པ་རེ་རེར་འགན་དང་དབང་ཚད་སྒྲིག་འགོད་བྱེད་ཐུབ།",
  "tierB.home.howItWorks.0.title": "ཁྱེད་ཀྱིས་ཚོང་ཇི་ལྟར་འཚོང་བ་ང་ཚོར་གསུངས།",
  "tierB.home.howItWorks.0.line": "རིན་གོང་དྲི་བའམ་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་འཇོག་རོགས། ང་ཚོས་ཁྱེད་ཀྱི་ངོ་ཚབ་དང་འགྲོ་ལམ། ཚོང་ཟོག ཚོང་འཛིན་གྱི་དགོས་མཁོ་བཅས་ལ་ལྟ་ཞིབ་བྱེད།",
  "tierB.home.howItWorks.1.title": "ཁྱེད་ཀྱི་ཀུང་སི་སྒྲིག་འགོད་གནང་།",
  "tierB.home.howItWorks.1.line": "ཚོང་ཟོག་དང་རིན་གོང་། ཉོ་མཁན། ངོ་ཚབ་བཅས་ནང་འཇུག་གནང་ནས། སྒྲིག་འགོད་ནང་རང་རྒྱལ་གྱི་དངུལ་ལོར་དང་ཁྲལ་ཚད་གཏན་འཁེལ་གནང་།",
  "tierB.home.howItWorks.2.title": "ངོ་ཚབ་ཚོ་ལམ་ཐོག་གི་ལས་ཀར་གཏོང་།",
  "tierB.home.howItWorks.2.line": "ངོ་ཚབ་ཚོས་ Android ཡང་ན་ iPhone ཐོག་ཉེར་སྤྱོད་མཉེན་ཆས་འཇུག་སྒྲིག་བྱས་ནས། རླངས་འཁོར་དུ་ཚོང་ཟོག་བཀལ་ཏེ་ཚོང་འཚོང་དང་པར་འདེབས། དངུལ་སྡུད་བཅས་འགོ་འཛུགས་བྱེད།",
  "tierB.home.howItWorks.3.title": "ཉིན་རེའི་ལས་ཀ་དུས་ཐོག་ཏུ་གཟིགས།",
  "tierB.home.howItWorks.3.line": "ངོ་ཚབ་ཚོ་ད་དུང་ལམ་ཐོག་ཏུ་ཡོད་སྐབས་ལྟ་ཞིབ་ངོས་ལེབ་ཀྱིས་ཚོང་འཚོང་དང་དངུལ་སྡུད། རླངས་འཁོར་གྱི་ཚོང་ཟོག འཚམས་འདྲི་བཅས་སྟོན།",
  "tierB.home.faq.0.q": "FieldSales ཟེར་བ་ཅི་ཞིག་ཡིན་ནམ།",
  "tierB.home.faq.0.a": "FieldSales ནི་ཚོང་ཟོག་བགོ་འགྲེམས་དང་སྤྱི་ཚོང་ཀུང་སིའི་ཚོང་འཚོང་ངོ་ཚབ་དོ་དམ་བྱེད་པའི་སྤྲིན་རྩིས་སྟེགས་བུ་ཞིག་ཡིན། དེའི་ནང་རླངས་འཁོར་ནས་ཚོང་འཚོང་ (van sales) དང་། འགྲོ་ལམ་ཚོང་འཚོང་། མངགས་ཉོ་ལེན་པ (pre-sales)། ཚོང་ཁང་དུ་ཐད་ཀར་སྐྱེལ་འདྲེན (DSD) བཅས་འདུས་ཡོད། ངོ་ཚབ་ཚོས་ཁ་པར་ནས་ཚོང་འཛིན་བཟོ་བ་དང་པར་འདེབས། དངུལ་སྡུད། འཚམས་འདྲི་ཐོ་འགོད་བཅས་བྱེད་ལ། འགན་འཛིན་པས་དྲ་ངོས་ལྟ་ཞིབ་ངོས་ལེབ་ནས་ཚོང་འཚོང་དང་དངུལ་སྡུད། རླངས་འཁོར་གྱི་ཚོང་ཟོག ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ་བཅས་ལ་ལྟ་ཞིབ་བྱེད།",
  "tierB.home.faq.1.q": "FieldSales དྲ་རྒྱ་མེད་པར་བཀོལ་ཐུབ་བམ།",
  "tierB.home.faq.1.a": "ཐུབ། ངོ་ཚབ་ཀྱི་ཉེར་སྤྱོད་མཉེན་ཆས་དྲ་རྒྱ་མེད་ཀྱང་མུ་མཐུད་ལས་ཀ་བྱེད། ངོ་ཚབ་ཀྱིས་ཚོང་འཛིན་དང་དངུལ་ལེན་འཛིན་ཤོག་བཟོ་སྟེ་པར་འདེབས་བྱེད་ཐུབ། འཚམས་འདྲི་ཐོ་འགོད་དང་ཉོ་མཁན་གསར་པ་ནང་འཇུག་བྱེད་ཐུབ། དྲ་རྒྱ་བསྐྱར་དུ་བྱུང་རྗེས་ཚང་མ་བསྐྱར་ཟློས་མེད་པར་རང་འགུལ་གྱིས་མཉམ་འགྲིག་འགྱུར། སའུ་དི་ཨ་རབ་ཏུ་དམིགས་བསལ་གཅིག་ཡོད། གློག་རྡུལ་ཚོང་འཛིན་སྦྲེལ་མཐུད་སྒོ་ཕྱེ་བའི་ཀུང་སི་ལ་ཚོང་འཛིན་ནམ་ཕྱིར་སློག་བཟོ་སྐབས་དྲ་རྒྱ་དགོས།",
  "tierB.home.faq.2.q": "FieldSales ཀྱིས་རྒྱལ་ཁབ་གང་དག་ལ་ཞབས་ཞུ་སྒྲུབ་བམ།",
  "tierB.home.faq.2.a": "FieldSales ཀྱིས་རྒྱལ་ཁབ་ཚང་མའི་བགོ་འགྲེམས་ཀུང་སི་ལ་ཞབས་ཞུ་སྒྲུབ། ཀུང་སི་རེ་རེས་རང་གི་སྒྲིག་འགོད་ནང་དངུལ་ལོར་དང་ཁྲལ་ཚད་གཏན་འཁེལ་བྱེད་ལ། ཚོང་འཛིན་དང་དངུལ་ལེན་འཛིན་ཤོག སྙན་ཞུ་བཅས་ལ་དེ་དག་བེད་སྤྱོད་བྱེད། FieldSales ཀྱི་དབུ་ཁང་སའུ་དི་ཨ་རབ་ཀྱི་རི་ཡཱ་དྷ་ན་ཡོད་ལ། ཐོག་མའི་སྒྲིག་འགོད་དང་ཁྲིད་སྟོན་ནི་དྲ་ཐོག་ཐུག་འཕྲད་དང་ཐག་རིང་རོགས་རམ། WhatsApp བཅས་བརྒྱུད་ནས་བྱེད།",
  "tierB.home.faq.3.q": "FieldSales གཞུང་གི་གློག་རྡུལ་ཚོང་འཛིན་མ་ལག་དང་སྦྲེལ་ཐུབ་བམ།",
  "tierB.home.faq.3.a": "ང་ཚོས་ ZATCA ཡི་ Fatoora སྟེགས་བུ་དང་རིམ་པ་གཉིས་པའི་སྦྲེལ་མཐུད་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད། འདི་ནི་སའུ་དི་ཨ་རབ་ཀྱི་ཀུང་སི་ཁོ་ནར་འབྲེལ། རྒྱལ་ཁབ་གཞན་དུ་ FieldSales ཀྱིས་ཁྱེད་ཀྱི་དངུལ་ལོར་དང་ཁྲལ་ཚད་ལྟར་ཚོང་འཛིན་བཟོ་ལ། རྒྱལ་ཁབ་དེའི་གཞུང་གི་གློག་རྡུལ་ཚོང་འཛིན་མ་ལག་དང་སྦྲེལ་མཐུད་ནི་རེ་ཞུ་ལྟར་མཁོ་སྤྲོད་ཐུབ། དེ་ཡང་རྒྱལ་ཁབ་དེའི་དགོས་མཁོ་ཁྱེད་དང་མཉམ་དུ་ཞིབ་དཔྱད་བྱས་རྗེས་ཡིན། སའུ་དི་ཨ་རབ་ཀྱི་ཕྱི་རོལ་གྱི་རྒྱལ་ཁབ་གང་གི་དགོས་མཁོ་ཡང་ཁ་ཚང་བར་ང་ཚོས་ཁས་ལེན་མི་བྱེད།",
  "tierB.home.faq.4.q": "FieldSales ཉེར་སྤྱོད་མཉེན་ཆས་སྐད་ཡིག་གང་དག་ཐོག་ཡོད་དམ།",
  "tierB.home.faq.4.a": "FieldSales ཉེར་སྤྱོད་མཉེན་ཆས་ཀྱི་ངོས་ལེབ་ནི་ ཨ་རབ་ཡིག དབྱིན་ཡིག ཧྥ་རན་སི་ཡིག ཏུར་ཀི་ཡིག་དང་རྒྱ་ཡིག ཁོ་ན་ཡིན། བོད་ཡིག་གི་ངོས་ལེབ་མེད། ངོ་ཚབ་དང་འགན་འཛིན་པས་ངོས་ལེབ་ཀྱི་སྐད་ཡིག་བརྗེ་ཐུབ་ལ། པར་འདེབས་བྱས་པའི་ཚོང་འཛིན་ཐོག་གཙོ་བོའི་སྐད་ཡིག་གི་འགྲམ་དུ་སྐད་ཡིག་གཉིས་པ་ཞིག་ཀྱང་འགོད་ཐུབ། སྐད་ཡིག་གཞན་གྱི་དྲ་ངོས་ཤོག་ངོས་རྣམས་དང་། བོད་ཡིག་ཤོག་ངོས་འདི་ཡང་ཐོན་རྫས་འདིའི་ཆ་འཕྲིན་སྤྲོད་ཆེད་ཀྱི་ཡིག་སྒྱུར་ཁོ་ན་ཡིན།",
  "tierB.home.faq.5.q": "FieldSales བེད་སྤྱོད་ཇི་ལྟར་འགོ་འཛུགས་དགོས་སམ།",
  "tierB.home.faq.5.a": "རིན་གོང་དྲི་བའམ་ཐུག་འཕྲད་ཀྱི་དུས་ཚོད་འཇོག་པ། ཡང་ན་ WhatsApp ནང་འཕྲིན་ཐུང་གཏོང་རོགས། ང་ཚོས་ཁྱེད་ཀྱི་ངོ་ཚབ་ཚོས་ལས་ཀ་ཇི་ལྟར་བྱེད་པ་ཤེས་རྟོགས་བྱས་རྗེས། ཚོང་ཟོག་དང་རིན་གོང་། ཉོ་མཁན། ངོ་ཚབ་བཅས་སྒྲིག་འགོད་བྱེད་པར་རོགས་རམ་བྱེད། ངོ་ཚབ་ཚོས་ Android ཡང་ན་ iPhone ཐོག་ཉེར་སྤྱོད་མཉེན་ཆས་འཇུག་སྒྲིག་བྱེད་ལ། འགན་འཛིན་པས་དྲ་བཤར་ཆས་གང་རུང་ནས་ལྟ་ཞིབ་ངོས་ལེབ་བེད་སྤྱོད་བྱེད། དགོས་པའི་སྒྲིག་ཆས་ནི་རིག་ནུས་ཁ་པར་ཁོ་ན་ཡིན།",
  "tierB.home.cta.quote": "རིན་གོང་དྲི་བ།",
  "tierB.home.cta.meeting": "ཐུག་འཕྲད་དུས་ཚོད་འཇོག་པ།",
  "tierB.home.cta.whatsapp": "WhatsApp ནང་ཁ་བརྡ་གཏོང་བ།",
  "tierB.home.uiLanguagesNote": "FieldSales ཉེར་སྤྱོད་མཉེན་ཆས་ཀྱི་ངོས་ལེབ་ནི་ ཨ་རབ་ཡིག དབྱིན་ཡིག ཧྥ་རན་སི་ཡིག ཏུར་ཀི་ཡིག་དང་རྒྱ་ཡིག ཐོག་ཡོད། བོད་ཡིག་ཐོག་མེད། སྐད་ཡིག་གཞན་གྱི་ཤོག་ངོས་ནི་ཐོན་རྫས་ངོ་སྤྲོད་ཁོ་ན་ཡིན།",
  "tierB.category.slugHint": "van-sales-software",
  "tierB.category.title": "རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས་ (van sales) | FieldSales",
  "tierB.category.description": "རླངས་འཁོར་ནས་ཚོང་འཚོང་དང་འགྲོ་ལམ་ཚོང་འཚོང་གི་མཉེན་ཆས། ངོ་ཚབ་ཀྱི་ཁ་པར་ནས་ཚོང་འཛིན་པར་འདེབས། རླངས་འཁོར་གྱི་ཚོང་ཟོག དངུལ་སྡུད། འཚམས་འདྲི། དྲ་མེད་ཀྱང་བཀོལ་ཐུབ།",
  "tierB.category.h1": "བགོ་འགྲེམས་དང་སྤྱི་ཚོང་ཀུང་སིའི་ཆེད་ཀྱི་རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས།",
  "tierB.category.intro": "FieldSales ནི་ཉིན་རེའི་འགྲོ་ལམ་ཐོག་རླངས་འཁོར་ནས་ཐད་ཀར་ཚོང་ཟོག་འཚོང་མཁན་གྱི་ངོ་ཚབ་ཡོད་པའི་ཀུང་སི་རྣམས་ཀྱི་ཆེད་དུ་བཟོས་པའི་རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས་ཤིག་ཡིན། ངོ་ཚབ་ཀྱིས་རླངས་འཁོར་དུ་ཚོང་ཟོག་བཀལ་ནས་ཚོང་ཁང་རེ་རེར་འཚོང་བ་དང་། ཚོང་འཛིན་པར་འདེབས། དངུལ་སྡུད། ཕྱིར་སློག་ཐོ་འགོད་བཅས་ཁ་པར་གྱི་ཉེར་སྤྱོད་མཉེན་ཆས་གཅིག་ནས་བྱེད། འགན་འཛིན་པས་རླངས་འཁོར་རེ་རེར་ཅི་བཀལ་བ་དང་ཅི་བཙོངས་པ། དངུལ་ག་ཚོད་བསྡུས་པ། ཅི་ལྷག་ཡོད་པ་བཅས་མཐོང་ཐུབ།",
  "tierB.category.sections.0.title": "རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས་ནི་ཅི་ཞིག་ཡིན་ནམ།",
  "tierB.category.sections.0.body": "རླངས་འཁོར་ནས་ཚོང་འཚོང་མཉེན་ཆས་ལ་འགྲོ་ལམ་ཚོང་འཚོང་མཉེན་ཆས་ཞེས་ཀྱང་ཟེར། དེས་ངོ་ཚབ་ཀྱིས་རླངས་འཁོར་ནང་ཚོང་ཟོག་ཁུར་ནས་འཚམས་འདྲི་ཐེངས་གཅིག་གི་ནང་འཚོང་བ་དང་སྐྱེལ་བ། ཚོང་འཛིན་བཟོ་བ། དངུལ་སྡུད་བཅས་བྱེད་པའི་ཚོང་འཚོང་བྱ་ཐབས་ལག་ལེན་བྱེད། དེས་ཤོག་བུའི་ཚོང་འཛིན་དེབ་དང་དགོང་མོའི་ཁ་པར་གཏོང་བ་ཚབ་བྱེད། ཚོང་འཚོང་དང་དངུལ་སྤྲོད། ཕྱིར་སློག་རེ་རེ་ཡིག་ཆ་ཞིག་ཏུ་ཐོ་འགོད་བྱེད་པས། ཚོང་ཟོག་དང་དངུལ་ལག་ཉིན་དེ་ཉིད་ལ་བསྡུར་ཞིབ་བྱེད་ཐུབ། འགན་འཛིན་པའི་ཆེད་དུ་དེས་དགོང་མོ་རེར་དྲི་བ་གསུམ་ལ་ལན་འདེབས་བྱེད། ངོ་ཚབ་རེ་རེས་ཅི་བཙོངས་པ་དང་། དངུལ་ག་ཚོད་བསྡུས་པ། རླངས་འཁོར་རེ་རེར་ད་དུང་ཅི་ལྷག་ཡོད་པ་བཅས་ཡིན།",
  "tierB.category.sections.1.title": "ལམ་ཐོག་གི་ཉིན་གཅིག",
  "tierB.category.sections.1.body": "ཉིན་རེའི་ལས་ཀ་ནི་མཛོད་ཁང་ནས་རླངས་འཁོར་དུ་ཐོ་འགོད་ཡོད་པའི་ཚོང་ཟོག་བཀལ་བ་ནས་འགོ་འཛུགས། ཚོང་ཁང་རེ་རེར་ངོ་ཚབ་ཀྱིས་ཉོ་མཁན་གྱི་ཐོ་ཁ་ཕྱེ་ནས། ཐོ་གཞུང་ངམ་བར་ཀོཌ་ནས་ཚོང་ཟོག་ནང་འཇུག་བྱེད་ཅིང་ཚོང་འཛིན་བཟོས་ཏེ་ཚ་དྲོད་པར་འཕྲུལ་ཐོག་པར་འདེབས་བྱེད། དངུལ་སྤྲོད་ནི་དངུལ་ལེན་འཛིན་ཤོག་གིས་ཐོ་འགོད་བྱེད་ལ། ཕྱིར་སློག་ཡོད་ཚེ་རྒྱུ་མཚན་དང་བཅས་ཐོ་འགོད་བྱེད། ཉིན་མཐའ་རླངས་འཁོར་ནང་ལྷག་པའི་ཚོང་ཟོག་མཛོད་ཁང་དུ་ཕབ། བར་སྐབས་དེར་འགན་འཛིན་པས་སུ་ལའང་ཁ་པར་མ་བཏང་བར་དྲ་ངོས་ལྟ་ཞིབ་ངོས་ལེབ་ནས་ངོ་ཚབ་རེ་རེའི་ཚོང་འཚོང་དང་དངུལ་སྡུད། འཚམས་འདྲི་བཅས་ལྟ་ཐུབ།",
  "tierB.category.sections.2.title": "བརྡ་རྟགས་ཞན་པའི་ས་ཆའི་ཆེད་དུ་བཟོས་པ།",
  "tierB.category.sections.2.body": "བགོ་འགྲེམས་ཀྱི་འགྲོ་ལམ་ས་འོག་ཁང་པ་དང་བཟོ་ལས་ས་ཁུལ། བརྡ་རྟགས་ཞན་པའི་གྲོང་གསེབ་དང་རི་ཁུལ་བཅས་བརྒྱུད་ནས་འགྲོ། FieldSales ཀྱི་ངོ་ཚབ་ཉེར་སྤྱོད་མཉེན་ཆས་ཀྱིས་ཉོ་མཁན་དང་ཚོང་ཟོག རིན་གོང་བཅས་ཁ་པར་ནང་ཉར་ཚགས་བྱེད་པས། ངོ་ཚབ་ཀྱིས་དྲ་རྒྱ་མེད་ཀྱང་ཡིག་ཆ་བཟོ་སྟེ་པར་འདེབས་བྱེད་ཐུབ། ཡིག་ཆ་རེ་རེར་ལྡེ་མིག་ཐུན་མོང་མ་ཡིན་པ་ཞིག་ཡོད་པས། ཡར་འཇུག་ཐེངས་མང་པོ་བསྐྱར་ཟློས་བྱས་ཀྱང་ཐེངས་གཅིག་ཁོ་ན་ཡར་འཇུག་འགྱུར། གློག་རྡུལ་ཚོང་འཛིན་སྦྲེལ་མཐུད་སྒོ་ཕྱེ་བའི་སའུ་དི་ཨ་རབ་ཀྱི་ཀུང་སི་ལ་ཚོང་འཛིན་དང་ཕྱིར་སློག་བཟོ་སྐབས་དྲ་རྒྱ་དགོས། དེ་དག་ལའང་དངུལ་ལེན་འཛིན་ཤོག་དང་འཚམས་འདྲི། ཉོ་མཁན་གསར་པ་བཅས་དྲ་རྒྱ་མེད་པར་བཀོལ་ཐུབ།",
  "tierB.category.sections.3.title": "དངུལ་སྡུད་དང་རླངས་འཁོར་གྱི་ཚོང་ཟོག་འགན་འཁྲི།",
  "tierB.category.sections.3.body": "ལམ་ཐོག་གི་དངུལ་ལག་ལའང་ཚོང་ཟོག་དང་འདྲ་བའི་ཚོད་འཛིན་དགོས། དངུལ་སྡུད་རེ་རེར་ཨང་རྟགས་ཅན་གྱི་དངུལ་ལེན་འཛིན་ཤོག་རེ་ཡོད་ལ། དེ་སྤྲོད་ཟིན་པའི་ཚོང་འཛིན་དང་འབྲེལ་ཐུབ། ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ་མྱུར་དུ་གསར་བསྒྱུར་འགྱུར། རླངས་འཁོར་གྱི་ཚོང་ཟོག་རིགས་རེ་རེ་བཀལ་གྲངས་ནས་བཙོངས་གྲངས་ཕྲིས་ཏེ་ཕྱིར་སློག་དང་ཐོ་འགོད་ཡོད་པའི་བཟོ་བཅོས་བསྣན་ནས་རྩིས་རྒྱག་པས། ངོ་ཚབ་ཁྱིམ་དུ་མ་ལོག་གོང་འགན་འཛིན་པས་དངོས་ཡོད་གྲངས་འབོར་དང་བསྡུར་ཐུབ། ཕྱིར་སློག་ལ་རྒྱུན་ལྡན་དང་། སྐྱོན་ཅན། བརྗེ་རེས་བཅས་སུ་དབྱེ་ཐུབ་ལ། ཕྱིར་སློག་ཚོང་ཟོག་རླངས་འཁོར་གྱི་འཚོང་རུང་བའི་ཚོང་ཟོག་ཏུ་ལོག་མིན་འགན་འཛིན་པས་ཐག་གཅོད་བྱེད།",
  "tierB.category.sections.4.title": "སུ་ལ་འཚམ་པ།",
  "tierB.category.sections.4.body": "FieldSales ནི་ཟས་རིགས་དང་བཏུང་བ། གཙང་སེལ་ཡོ་བྱད། ལུས་ཀྱི་གཙང་སྦྲའི་ཡོ་བྱད་ལྟ་བུའི་མྱུར་དུ་འཚོང་བའི་ཚོང་ཟོག་ (FMCG) བགོ་འགྲེམས་པ་དང་སྤྱི་ཚོང་པ་ལ་འཚམ་ལ། འགྲོ་ལམ་ལྟར་ཚོང་ཁང་ལ་འཚམས་འདྲི་བྱེད་མཁན་གྱི་ངོ་ཚབ་ཡོད་པའི་ཀུང་སི་གང་རུང་ལའང་འཚམ། FieldSales ཀྱིས་རླངས་འཁོར་ནས་ཚོང་འཚོང་དང་མངགས་ཉོ་ལེན་པ། ཚོང་ཁང་དུ་ཐད་ཀར་སྐྱེལ་འདྲེན་བཅས་ལ་རྒྱབ་སྐྱོར་བྱེད། དེ་ནི་ ERP ཆ་ཚང་མ་ཡིན། API བརྒྱུད་ནས་ཁྱེད་ཀྱི་རྩིས་ཁྲ་ཡང་ན་ ERP མ་ལག་དང་སྦྲེལ་ཐུབ། ཆག་ཡང་སྤྲོད་པ་དང་། ཐོ་གཞུང་གི་རིན་གོང་ལས་དམའ་བར་འཚོང་བ། ཉོ་མཁན་གསར་པ་ནང་འཇུག་ལྟ་བུ་ངོ་ཚབ་རེ་རེས་ཅི་བྱེད་ཆོག་པ་འགན་འཛིན་པས་ཚོད་འཛིན་བྱེད།",
  "tierB.category.faq.0.q": "རླངས་འཁོར་ནས་ཚོང་འཚོང་དང་མངགས་ཉོ་ལེན་པ (pre-sales) གཉིས་ཀྱི་ཁྱད་པར་ཅི་ཡིན།",
  "tierB.category.faq.0.a": "རླངས་འཁོར་ནས་ཚོང་འཚོང་གི་ནང་ངོ་ཚབ་ཀྱིས་ཚོང་ཟོག་ཁུར་ནས་འཚམས་འདྲི་ཐེངས་གཅིག་གི་ནང་སྐྱེལ་བ་དང་ཚོང་འཛིན་བཟོ་བ། དངུལ་སྡུད་བཅས་བྱེད། མངགས་ཉོ་ལེན་པའི་ནང་ངོ་ཚབ་ཀྱིས་མངགས་ཉོ་ལེན་ལ། མཛོད་ཁང་ནས་རྗེས་སུ་སྐྱེལ། FieldSales ཀྱིས་གཉིས་ཀ་ལ་རྒྱབ་སྐྱོར་བྱེད་པས། ཀུང་སི་གཅིག་གིས་འགྲོ་ལམ་ཁ་ཤས་སུ་རླངས་འཁོར་ནས་ཚོང་འཚོང་དང་གཞན་དུ་མངགས་ཉོ་ལེན་པ་ལག་ལེན་བྱེད་ཐུབ། བྱ་ཐབས་གཉིས་ཀའི་ནང་ཚོང་འཛིན་དང་དངུལ་སྡུད། ཉོ་མཁན་གྱི་སྤྲོད་རྒྱུ་ལྷག་མ་བཅས་མ་ལག་གཅིག་ཏུ་ཡོད་ལ། འགན་འཛིན་པས་སྙན་ཞུ་གཅིག་ཏུ་མཐོང་ཐུབ།",
  "tierB.category.faq.1.q": "ཉིན་མཐའ་རླངས་འཁོར་གྱི་རྩིས་ཇི་ལྟར་བསྡུར་ཞིབ་བྱེད་དགོས་སམ།",
  "tierB.category.faq.1.a": "FieldSales ཀྱིས་རླངས་འཁོར་རེ་རེའི་ཚོང་ཟོག་རིགས་རེ་རེའི་བཀལ་གྲངས་དང་བཙོངས་གྲངས། ཕྱིར་སློག་གྲངས། ལྷག་གྲངས་བཅས་སྟོན། ལྷག་གྲངས་དེ་དངོས་ཡོད་གྲངས་འབོར་དང་བསྡུར་ནས། ཁྱད་པར་ཡོད་ན་ཐོ་འགོད་ཡོད་པའི་བཟོ་བཅོས་སུ་འགོད། དེ་རྗེས་ལྷག་མ་རྣམས་ཐེངས་གཅིག་གིས་མཛོད་ཁང་དུ་ཕབ། ཉིན་རྗེས་མར་རླངས་འཁོར་གྱི་རྩིས་གཙང་ཞིང་གསལ་པོས་འགོ་འཛུགས།",
  "tierB.category.faq.2.q": "རླངས་འཁོར་ནས་ཚོང་འཚོང་བའི་ངོ་ཚབ་ལ་སྒྲིག་ཆས་ཅི་དགོས་སམ།",
  "tierB.category.faq.2.a": "རིག་ནུས་ཁ་པར་གཅིག Android ཡང་ན་ iPhone ཡིན། Bluetooth ཚ་དྲོད་པར་འཕྲུལ་ནི་འདེམས་རུང་ཡིན་ལ། དེས་ངོ་ཚབ་ཀྱིས་ཉོ་མཁན་ལ་པར་འདེབས་བྱས་པའི་ཚོང་འཛིན་ནམ་དངུལ་ལེན་འཛིན་ཤོག་སྤྲོད་ཐུབ། FieldSales ཀྱིས་སྒྲིག་ཆས་མི་འཚོང་ལ་ཚོང་རྟགས་དམིགས་བསལ་གྱི་པར་འཕྲུལ་ཡང་མི་དགོས། འགན་འཛིན་པས་གློག་ཀླད་དམ་ཁ་པར་གང་རུང་གི་དྲ་བཤར་ཆས་ནས་ལྟ་ཞིབ་ངོས་ལེབ་བེད་སྤྱོད་བྱེད།",
  "tierB.category.faq.3.q": "FieldSales ང་ཚོའི་རྩིས་ཁྲའི་མ་ལག་དང་སྦྲེལ་ཐུབ་བམ།",
  "tierB.category.faq.3.a": "ཐུབ། FieldSales ལ་ API ཡོད་ལ། དེ་བརྒྱུད་ཁྱེད་ཀྱི་རྩིས་ཁྲ་ཡང་ན་ ERP མ་ལག་གིས་སྟེགས་བུ་དང་ཉོ་མཁན། ཚོང་ཟོག ཚོང་འཛིན། དངུལ་ལེན་འཛིན་ཤོག ཚོང་ཟོག་གི་འགུལ་སྐྱོད་བཅས་བརྗེ་རེས་བྱེད་ཐུབ། ཁྱེད་ཀྱི་རུ་ཁག་གམ་ལག་རྩལ་རོགས་པས་ API ཡིག་ཆ་ལ་བརྟེན་ནས་སྦྲེལ་མཐུད་བཟོ།",
  "tierB.countries.title": "FieldSales རྒྱལ་ཁབ་སོ་སོར། དངུལ་ལོར། ཁྲལ། གློག་རྡུལ་ཚོང་འཛིན",
  "tierB.countries.description": "FieldSales ནི་རྒྱལ་ཁབ་ཚང་མའི་བགོ་འགྲེམས་པ་ལ་བཀོལ་ཐུབ། རྒྱལ་ཁབ་རེ་རེའི་དངུལ་ལོར་དང་ཚོང་ཁྲལ། གློག་རྡུལ་ཚོང་འཛིན་གྱི་གནས་སྟངས་རེའུ་མིག་གཅིག་ཏུ་གཟིགས།",
  "tierB.countries.h1": "རྒྱལ་ཁབ་ 249 ནང་གི་ FieldSales",
  "tierB.countries.intro": "FieldSales ཀྱིས་རྒྱལ་ཁབ་ཚང་མའི་བགོ་འགྲེམས་ཀུང་སི་ལ་ཞབས་ཞུ་སྒྲུབ། ཀུང་སི་རེ་རེས་རང་གི་སྒྲིག་འགོད་ནང་རྒྱལ་ཁབ་དང་དངུལ་ལོར། ཁྲལ་ཚད་བཅས་འདེམས་ལ། ཚོང་འཛིན་དང་དངུལ་ལེན་འཛིན་ཤོག སྙན་ཞུ་བཅས་དེ་ལྟར་འགྲོ། གཞུང་གི་གློག་རྡུལ་ཚོང་འཛིན་སྦྲེལ་མཐུད་ནི་སའུ་དི་ཨ་རབ་ཁོ་ནར་ལག་ལེན་ཡོད། རྒྱལ་ཁབ་གཞན་ཚང་མར་དེ་རེ་ཞུ་ལྟར་མཁོ་སྤྲོད་ཐུབ། གཤམ་གྱི་རེའུ་མིག་ནང་རྒྱལ་ཁབ་རེ་རེའི་ས་གནས་དངུལ་ལོར་དང་། སྤྱིར་བཏང་གི་ཚོང་ཁྲལ་ལམ་ VAT ཡི་ཚད། གཞུང་གི་གློག་རྡུལ་ཚོང་འཛིན་སྦྲེལ་མཐུད་ལག་ལེན་ཡོད་མེད་དམ་རེ་ཞུ་ལྟར་མཁོ་སྤྲོད་ཡིན་མིན་བཅས་བཀོད་ཡོད།",
  "tierB.countries.columns.country": "རྒྱལ་ཁབ",
