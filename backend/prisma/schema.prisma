// ============================================================================
// منصّة صيد العملاء المحتملين (Hunter) — **نسخة معزولة تماماً داخل فيلد سيلز**.
// لا علاقة لهذه الجداول بأيّ جدول من المنصّة (Tenant/Admin/SalesRep/Lead...):
// حساباتها مستقلّة بمصادقتها الخاصّة، وكل حساب لا يرى إلا عملاءه هو.
// الجداول ببادئة hunter_ فلا تتقاطع مع leads/ الوحدة القديمة.
// ============================================================================

/// حساب على منصّة الصيد. يُنشئه المالك ويسلّم بياناته للشخص.
model HunterUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String // scrypt: salt:hash (بلا تبعيات خارجية)
  name          String?
  isActive      Boolean   @default(true)
  isOwner       Boolean   @default(false) // مالك المنصّة: يُنشئ الحسابات ويديرها
  // حصّة الخطة المجانية — تُعاد كل شهر
  monthlyQuota  Int       @default(500) // أقصى عدد عملاء جدد شهرياً
  usedThisMonth Int       @default(0)
  quotaResetAt  DateTime  @default(now())
  /// تاريخ انتهاء الاستخدام — بعده يُرفض الدخول وكل طلب (null = بلا انتهاء)
  expiresAt     DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leads    HunterLead[]
  searches HunterSearch[]

  @@map("hunter_users")
}

/// عميل محتمل مملوك لحسابٍ واحد. كل استعلام يُقيَّد بـuserId (عزل صارم).
model HunterLead {
  id          String     @id @default(uuid())
  userId      String
  user        HunterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?
  countryCode String?
  category    String?
  lat         Float?
  lng         Float?
  mapsUrl     String?
  source      String     @default("manual") // المصدر الأول
  sourcesCsv  String? // كل المصادر التي أكّدت هذا العميل، مفصولة بـ+
  sourceId    String? // معرّف المصدر الأصلي (osm:node/123)

  // مفاتيح إزالة التكرار المشتقّة — مفهرسة ليكون الفحص استعلاماً واحداً
  domainKey   String? // نطاق الموقع مطبّعاً
  phoneKey    String? // الهاتف مطبّعاً
  nameCityKey String? // الاسم+المدينة مطبّعين

  score     Int? // تقييم ملي 1..10
  scoreNote String?
  status    String   @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, score])
  @@index([userId, sourceId])
  @@index([userId, domainKey])
  @@index([userId, phoneKey])
  @@index([userId, nameCityKey])
  @@map("hunter_leads")
}

/// سجلّ عملية صيد (للتتبّع وتفادي تكرار الكلمات).
model HunterSearch {
  id        String     @id @default(uuid())
  userId    String
  user      HunterUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  providers String // المصادر المستخدمة مفصولة بـ+
  keywords  String // الكلمات مفصولة بفاصلة
  country   String?
  city      String?
  found     Int        @default(0)
  added     Int        @default(0)
  merged    Int        @default(0)
  errors    String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("hunter_searches")
}

/// نصوص الصفحة التعريفية القابلة للتحرير من لوحة المالك — مفتاح/قيمة.
/// القيمة نصّ عاديّ (لا HTML): تُهرَّب عند الحقن في الصفحة.
model HunterContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("hunter_content")
}

/// مصروف تشغيليّ للمنصّة نفسها (لا للشركات المشتركة) — أساس حساب الربح الحقيقي.
/// المالك يسجّل تكاليفه (استضافة، مفاتيح API، تسويق، اشتراكات) فيُحسب صافي الربح
/// آلياً بدل تقديره. `isRecurring` يعني يتكرّر شهرياً فيُحتسب في كل شهر لاحق
/// دون إعادة إدخال — وهذا ما يجعل الأتمتة ممكنة أصلاً.
// فاتورة ضريبية تُصدرها **المنصّة** لمشتركها عن اشتراكه.
// منفصلة تماماً عن فواتير الشركات لعملائها: البائع هنا نحن، والمشتري الشركة
// المشتركة. مؤسسةٌ مسجَّلة في ض.ق.م ملزمة بإصدارها عن كل بيع خاضع.
model PlatformInvoice {
  id            String   @id @default(uuid())
  number        String   @unique // تسلسل ظاهر للمشترك: FS-2026-0001
  paymentLinkId String   @unique // دفعة ميسر التي ولّدتها — يمنع فاتورتين لدفعة
  tenantId      String?
  buyerName     String // اسم الشركة المشترية وقت الإصدار (لا يتغيّر بتغيّر اسمها لاحقاً)
  buyerVatNo    String? // الرقم الضريبي للمشتري إن وُجد
  description   String
  totalSar      Float // الإجمالي شامل الضريبة
  vatSar        Float // الضريبة المستخرَجة منه
  netSar        Float // الوعاء قبل الضريبة
  qrBase64      String // رمز ZATCA بترميز TLV
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([issuedAt])
  @@map("platform_invoices")
}

model OperatingExpense {
  id             String    @id @default(uuid())
  label          String // وصف المصروف (Render، Groq، إعلانات…)
  category       String // hosting | ai | marketing | tools | salaries | other
  amountSar      Float // بالريال — الوعاء الموحّد للجمع (= amountOriginal × fxRate)
  // المبلغ كما يظهر في فاتورة المورّد فعلاً. حفظه يمنع الانحراف الصامت: حين
  // تتغيّر فاتورة Render بالدولار تُحدَّث قيمة واحدة، ولا يُعاد حساب الريال يدوياً.
  amountOriginal Float? // null = أُدخل بالريال مباشرة
  currency       String    @default("SAR") // SAR | USD | EUR
  fxRate         Float? // سعر التحويل المستعمل وقت الإدخال (الريال مربوط بالدولار 3.75)
  // آخر مراجعة للمبلغ. مصروف متكرّر لا يُراجَع يتقادم صامتاً ويظلّ يُحتسب بقيمة
  // قديمة إلى الأبد — وهذا أخطر من غيابه لأنه يبدو صحيحاً.
  reviewedAt     DateTime  @default(now())
  vatSar         Float     @default(0) // ضريبة مدفوعة على المصروف (مدخلات قابلة للخصم)
  isRecurring    Boolean   @default(false) // يتكرّر شهرياً
  startsOn       DateTime // بداية السريان (للمتكرّر) أو تاريخ الصرف (لغير المتكرّر)
  endsOn         DateTime? // نهاية سريان المتكرّر (null = مستمرّ)
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([startsOn])
  @@map("operating_expenses")
}

// علامات تشغيلية معمّرة — تبريد التقارير المجدولة كان متغيّرات ذاكرة تموت مع
// كل نشر: نشرةٌ داخل ساعة الثامنة تُسقط تقرير الشهر بلا تعويض ولا إنذار.
model OpsMarker {
  key       String   @id // daily:2026-08-27 | weekly:2026-W35 | monthly:2026-08
  value     String   @default("sent")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("ops_markers")
}

/// جدول أقساط فاتورة آجلة — **ثابت** بعد الإنشاء.
///
/// لا يغيّر محاسبة الفاتورة: القيد واحد بكامل الإجمالي لحظة البيع (الضريبة
/// تستحقّ بالتوريد لا بالتحصيل)، و`Invoice.remainingAmt` يبقى المصدر الوحيد
/// لأهليّة توزيع سند القبض.
///
/// ولا يحمل القسط `paidAmt` ولا `status` عمداً: حالته **دالّة** من
/// `Invoice.paidAmt` تُشتقّ بشلّال ترتيبيّ عند القراءة. فلا عدّادان يمكن أن
/// ينفصلا، ولا يُلمس مسار سداد واحد — إنشاء السند وإلغاؤه وتأكيد الدفع
/// الإلكتروني وردّه كلّها تعدّل `paidAmt` وتتبعها الأقساط تلقائياً.
model InvoiceInstallment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  seq       Int // ترتيب الاستحقاق 1..n
  dueDate   DateTime
  amount    Float // حصّة القسط من إجمالي الفاتورة (شاملة الضريبة)
  createdAt DateTime @default(now())

  @@unique([invoiceId, seq])
  @@index([invoiceId])
  @@index([tenantId, dueDate])
  @@map("invoice_installments")
}

// ============================================================================
// شرائح البروفايل — يرفعها مالك المنصّة من لوحته فتتغيّر الصفحة بلا نشر
// ============================================================================

/// شريحة واحدة من عرض البروفايل، صورةً ونصّاً.
///
/// **لماذا في قاعدة البيانات لا على القرص:** خدمة الخادم على Render بلا قرص
/// دائم، فأي ملف يُكتب في نظام الملفات يضيع مع أول إعادة نشر أو إعادة تشغيل —
/// وكان المالك يرفع بروفايله فيختفي بلا إنذار. والقاعدة هي المخزن الدائم
/// الوحيد المتاح هنا، وهي مشمولة بالنسخ الاحتياطي اليوميّ أصلاً.
///
/// والحجم محسوب: إحدى عشرة شريحة WebP بدقّة 2400×1350 ≈ ميغابايت واحد لكل
/// العرض — لا شيء على Postgres، ويُخدَم بترويسات تخزين طويلة ومفتاح نسخة في
/// الرابط فلا يُطلب مرّتين من المتصفّح نفسه.
///
/// وحين يخلو الجدول تعود الصفحة إلى الشرائح المدمَجة في البناء، فلا تُكسَر أبداً.
model ProfileSlide {
  id        String   @id @default(uuid())
  /// ترتيب العرض 1..n — فريد فلا شريحتان في موضع واحد
  seq       Int      @unique
  mime      String   @default("image/webp")
  bytes     Bytes
  width     Int
  height    Int
  /// عنوان الشريحة — يصير بديل الصورة لقارئات الشاشة
  title     String   @default("")
  /// سطور الشريحة (سطرٌ لكل خطّ) — محتوى يفهرسه محرّك البحث
  lines     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("profile_slides")
}

/// ملفّ البروفايل القابل للتنزيل (PDF) — صفٌّ واحد اسمه main.
/// يرفعه المالك مع الشرائح، فزرّ التنزيل في الصفحة يخدم أحدثَ ما رفع.
model ProfileFile {
  id        String   @id @default("main")
  mime      String   @default("application/pdf")
  bytes     Bytes
  /// الاسم الذي يُحفَظ به عند الزائر
  name      String   @default("بروفايل Field Sales.pdf")
  updatedAt DateTime @updatedAt

  @@map("profile_file")
}
