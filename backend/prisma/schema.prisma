generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// القيم المسموحة موثّقة بجانب كل حقل

// مالك المنصّة (بائع النظام) — يدير كل الشركات والاشتراكات
model SuperAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// الشركة المشتركة في النظام — الكيان الأعلى لعزل البيانات
model Tenant {
  id                        String    @id @default(uuid())
  name                      String // اسم الشركة المشتركة
  isActive                  Boolean   @default(true) // تعطيل الاشتراك يمنع كل مستخدميها من الدخول
  plan                      String    @default("basic") // basic | pro | enterprise (لم يعد يُعرض في الواجهة)
  // بقايا وحدة المطاعم المحذوفة — عمودٌ يتيم لا يقرؤه كود. لا يُسقط مع الحذف
  // لأن إسقاط عمود من `tenants` يجري في preDeploy بينما النسخة القديمة تخدم.
  // القيمة الافتراضية distribution ⇒ كل الشركات القائمة تُصنَّف توزيعاً عند db push دون لمس القاعدة.
  vertical                  String    @default("distribution") // يتيم بعد حذف وحدة المطاعم
  maxSalesReps              Int? // الحد الأقصى لعدد المناديب (null = غير محدود)
  maxAdminUsers             Int? // الحد الأقصى لمستخدمي لوحة الشركة (null = غير محدود)
  maxPosStations            Int? // يتيم بعد حذف وحدة المطاعم — يبقى لئلا يُسقط عمود من جدول حيّ
  maxBranches               Int? // يتيم بعد حذف وحدة المطاعم
  erpEnabled                Boolean   @default(false) // صلاحية ربط ERP — يتحكّم بها المالك حسب الاشتراك
  petroappEnabled           Boolean   @default(false) // صلاحية ربط بترو آب — يفعّلها المالك لكل شركة حسب الاشتراك
  hatifEnabled              Boolean   @default(false) // ميزة أرقام العمل وربط هاتف — يفعّلها المالك لكل شركة حسب الاشتراك
  catalogEnabled            Boolean   @default(false) // ميزة منيو المنتجات العام — يفعّلها المالك لكل شركة حسب الاشتراك
  warehouseEnabled          Boolean   @default(false) // مخزون الشركة (المستودع المركزيّ) — يُفعّله المالك لكل شركة (طرح مدروس)
  accountingEnabled         Boolean   @default(true) // النظام المحاسبي (منتجات · مخزون سيارات · مستودع · فواتير · سندات) — الوحيد المفعّل افتراضياً للجميع، يطفئه المالك لكل شركة
  receivablesSummaryEnabled Boolean   @default(false) // سطر «إجمالي مديونية العملاء المُسنَدين (بلا تكرار)» في تقرير المديونيات — يُفعّله المالك لكل شركة (طرح محدود)
  paylinkEnabled            Boolean   @default(false) // ميزة الدفع الإلكتروني (روابط دفع ميسر عبر حسابنا المجمِّع) — يفعّلها المالك لكل شركة حسب الاشتراك
  paylinkFeePct             Float     @default(4) // نسبة عمولتنا على كل تحصيل إلكتروني — لكل شركة على حدة (شاملة الضريبة)
  paylinkFeeFlat            Float     @default(1) // الريال الثابت لكل دفعة — شامل الضريبة
  subscriptionEndsAt        DateTime? // تاريخ انتهاء الاشتراك (null = غير محدود)
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  admins               Admin[]
  salesReps            SalesRep[]
  categories           ProductCategory[]
  products             Product[]
  customers            Customer[]
  invoices             Invoice[]
  receipts             Receipt[]
  accountEntries       AccountEntry[]
  notifications        Notification[]
  settings             CompanySettings?
  erpIntegration       ErpIntegration?
  petroappIntegration  PetroappIntegration?
  telephonyIntegration TelephonyIntegration?
  workChannels         WorkChannel[]
  callLogs             CallLog[]
  zatcaEgs             ZatcaEgs?
  erpSyncLogs          ErpSyncLog[]
  vanLoads             VanLoad[]
  warehouseEntries     WarehouseEntry[]
  repLocations         RepLocation[]
  repSettlements       RepSettlement[]
  importBatches        ImportBatch[]
  customerAssignments  CustomerAssignment[]
  adminCustomerScopes  AdminCustomerScope[]
  adminRepScopes       AdminRepScope[]

  RepVisit             RepVisit[]
  RepSession           RepSession[]
  customerPaymentLinks CustomerPaymentLink[]
  settlementEntries    SettlementEntry[]
  invoiceInstallments  InvoiceInstallment[]
  payouts              Payout[]

  @@map("tenants")
}

// دفعة استيراد — تسجّل ما أُنشئ في كل رفعة لإتاحة التراجع/الإزالة الآمنة
model ImportBatch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // customers | products | balances | ledger | prices
  count     Int      @default(0)
  recordIds String // JSON: مصفوفة معرّفات السجلات المُنشأة (للتراجع)
  createdBy String?
  reverted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("import_batches")
}

model Admin {
  id            String  @id @default(uuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  email         String  @unique
  passwordHash  String
  role          String  @default("ADMIN") // ADMIN | MANAGER | ACCOUNTANT
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false) // تأكيد ملكية البريد (تحقّق التسجيل الذاتي)

  // Company admin permissions
  canAccessDashboard       Boolean @default(true)
  canManageCustomers       Boolean @default(true)
  canManageProducts        Boolean @default(true)
  canManageSalesReps       Boolean @default(true)
  canManageInvoices        Boolean @default(true)
  canManageReceipts        Boolean @default(true)
  canViewReports           Boolean @default(true)
  canManageVanStock        Boolean @default(true)
  canManageTracking        Boolean @default(true)
  canManageCompanySettings Boolean @default(true)
  canManageCompanyUsers    Boolean @default(true)

  // عزل نطاق المستخدم الإداري: عند التفعيل لا يرى إلا العملاء والمناديب
  // المُسنَدين له (AdminCustomerScope / AdminRepScope). افتراضي false ⇒ كل
  // المستخدمين القائمين يبقون على رؤيتهم الكاملة عند db push (لا انقطاع).
  scopeEnabled Boolean @default(false)

  // آخر ظهور — يُلمَس في وسيط المصادقة (مخنوقاً لمرة/دقيقة) ليغذّي عدّاد «الزيارات الحية»
  // في لوحة المالك. اختياري: الصفوف القائمة تبقى null حتى أوّل طلب بعد النشر (لا انقطاع).
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerScopes AdminCustomerScope[]
  repScopes      AdminRepScope[]

  @@index([tenantId])
  @@index([lastSeenAt])
  @@map("admins")
}

/// العملاء الذين يراهم مستخدم إداري مقيّد النطاق (قائمة مستقلّة عن المناديب).
model AdminCustomerScope {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([adminId, customerId])
  @@index([tenantId, adminId])
  @@map("admin_customer_scopes")
}

/// المناديب الذين يراهم مستخدم إداري مقيّد النطاق (قائمة مستقلّة عن العملاء).
model AdminRepScope {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([adminId, salesRepId])
  @@index([tenantId, adminId])
  @@map("admin_rep_scopes")
}

model SalesRep {
  id           String  @id @default(uuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  username     String  @unique
  passwordHash String
  isActive     Boolean @default(true)
  fcmToken     String?

  // Sales permissions
  canCreateInvoice     Boolean      @default(true)
  workChannel          WorkChannel? // رقم العمل المُسنَد (يملكه المستأجر لا المندوب — يعود للمخزون عند الاستقالة)
  canSellOnCredit      Boolean      @default(true)
  /// البيع بالتقسيط ائتمانٌ أطول أجلاً من الآجل — فله إذن مستقلّ فوقه.
  /// الافتراضي false: لا يُفتح لأحد إلا بقرار صريح من الإدارة.
  canSellOnInstallment Boolean      @default(false)
  canSellInCash        Boolean      @default(true)
  canEditInvoice       Boolean      @default(false)
  canDeleteInvoice     Boolean      @default(false)
  canCancelInvoice     Boolean      @default(false)

  // Pricing permissions
  canChangePrice    Boolean @default(false)
  maxDiscountPct    Float   @default(0)
  canSellBelowPrice Boolean @default(false)

  // Collection permissions
  canCreateReceipt Boolean @default(true)
  canEditReceipt   Boolean @default(false)
  canCancelReceipt Boolean @default(false)

  // Customer permissions
  canAddCustomer   Boolean @default(false)
  canEditCustomer  Boolean @default(false)
  canViewStatement Boolean @default(true)
  /// «البيع داخل نطاق العميل»: عَلَمٌ تقييديّ لا مانح — تفعيله يسلب لا يمنح.
  /// حين يكون true لا يفتح المندوب ملفّ العميل إلا وهو داخل ٥٠ متراً من موقعه
  /// المسجَّل، والعميل بلا إحداثيات يُمنع منعاً باتّاً. وحين يكون false يفتح
  /// الجميع بلا قيد كما هو الحال اليوم.
  requireCustomerProximity Boolean @default(false)

  // إظهار رصيد التحصيل المتراكم للمندوب على شاشته الرئيسية (يحدّده الأدمن لكل مندوب)
  showCollectionBalance Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Van stock permission — هل يستطيع المندوب إدارة مخزون سيارته
  canManageVanStock   Boolean @default(true)
  // هل يستطيع البيع دون توفّر مخزون كافٍ بالسيارة (true = بلا قيد؛ false = يُمنع البيع فوق المتبقّي)
  canSellWithoutStock Boolean @default(true)

  // GPS tracking — آخر موقع معروف + إتاحة التتبّع لهذا المندوب
  canBeTracked Boolean   @default(true)
  lastLat      Float?
  lastLng      Float?
  lastSeenAt   DateTime?

  invoices      Invoice[]
  receipts      Receipt[]
  notifications Notification[]
  vanLoads      VanLoad[]
  locations     RepLocation[]
  settlements   RepSettlement[]
  RepVisit      RepVisit[]
  RepSession    RepSession[]

  // عزل العملاء: العملاء المُسنَدون لهذا المندوب، والعملاء الذين فتحهم بنفسه
  customerAssignments CustomerAssignment[]
  adminScopes         AdminRepScope[]
  createdCustomers    Customer[]            @relation("CustomerCreatedByRep")
  paymentLinks        CustomerPaymentLink[]

  @@index([tenantId])
  @@index([lastSeenAt])
  @@map("sales_reps")
}

/// روابط دفع ميسر — يصدرها مالك المنصة بمبلغ يحدده بنفسه ويرسلها للعميل.
/// الدفع يتم على صفحة ميسر المستضافة (لا تمر بيانات بطاقة بنظامنا اطلاقا).
/// عند التحقق من الدفع: تسجل الدفعة، وان حددت شهور تمديد ومعها شركة يمدد اشتراكها.
model PaymentLink {
  id               String    @id @default(uuid())
  tenantId         String? // ربط اختياري بشركة (للتوثيق والتمديد التلقائي)
  description      String // وصف يظهر للعميل على صفحة الدفع
  amountHalalas    Int // المبلغ بالهللات (ريال × ١٠٠) — مصدر الحقيقة للمطابقة
  months           Int       @default(0) // شهور تمديد الاشتراك عند الدفع (٠ = تسجيل فقط)
  moyasarInvoiceId String?   @unique // معرف الفاتورة لدى ميسر
  url              String? // رابط صفحة الدفع المستضافة
  status           String    @default("initiated") // initiated | paid | canceled | expired
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("payment_links")
}

// رابط دفع فاتورة عميل — قلب ميزة «الدفع الإلكتروني».
//
// النموذج التشغيلي (قرار المالك): نحن نجمع ثم نوزّع — العميل يدفع عبر ميسر إلى
// حسابنا المجمِّع، ونحن ندين للشركة بالمحصَّل ناقصَ عمولتنا (paylinkFeePct/Flat)،
// والتوريد أسبوعي كل خميس من حسابنا البنكي (مؤتمت مع البنك خارج النظام).
//
// القيود المتعمدة:
//  - الرابط لا يولد إلا من فاتورة قائمة وبكامل متبقيها لحظة الإصدار — لا رابط حر.
//  - token غير قابل للتخمين (32 بايت عشوائية) لأن صفحة الدفع عامة بلا مصادقة.
//  - المبلغ يجمد لحظة الإصدار، وصلاحية الرابط تفحص لحظة الدفع لا الإصدار:
//    إن سدد نقدا بعد الإصدار مات الرابط بدل أن يصنع دفعة زائدة.
model CustomerPaymentLink {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token       String    @unique // معرف الصفحة العامة /pay/:token
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  // المصدر مندوب أو أدمن — نحفظ الاثنين للتقرير («المحصل إلكترونيا لكل مندوب»)
  salesRepId  String?
  salesRep    SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  createdById String? // معرف الأدمن حين يصدر من اللوحة

  amount           Float // متبقي الفاتورة لحظة الإصدار — مجمد، والتحقق لحظة الدفع
  moyasarInvoiceId String?   @unique // فاتورة ميسر — مرجع المطابقة الوحيد الموثوق
  url              String? // صفحة الدفع المستضافة لدى ميسر
  status           String    @default("initiated") // initiated | paid | canceled | expired
  paidAt           DateTime?
  moyasarPaymentId String? // الدفعة لدى ميسر بعد السداد — يلزم للاسترداد
  receiptId        String?   @unique // سند القبض الذي أنشأه السداد (المعاملة الواحدة)
  expiresAt        DateTime // انتهاء تلقائي — رابط واتساب قد يفتح بعد أسابيع

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  @@map("customer_payment_links")
}

// دفتر أمانات الشركات — نفس فلسفة AccountEntry: قيود موقعة لا رصيد مخزن.
// الرصيد = مجموع القيود، فلا يوجد رقم قابل للانحراف عن مصدره.
//
// الأنواع: COLLECTED (+ المحصل كاملا) · FEE (− عمولتنا شاملة الضريبة) ·
// PAYOUT (− ما ورد للشركة) · REFUND (− عكس استرداد).
// feeNet/feeVat يفصلان إيرادنا عن ضريبته لإقرارنا — مجموعهما قيمة قيد FEE.
model SettlementEntry {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // COLLECTED | FEE | PAYOUT | REFUND
  amount    Float // موقع: التحصيل موجب والباقي سالب
  feeNet    Float? // على قيود FEE فقط: إيرادنا قبل الضريبة
  feeVat    Float? // على قيود FEE فقط: ضريبة عمولتنا (تستخرج لا تضاف)
  linkId    String? // رابط الدفع مصدر القيد (COLLECTED/FEE/REFUND)
  payoutId  String?
  payout    Payout?  @relation(fields: [payoutId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, kind])
  @@index([tenantId, createdAt])
  @@map("settlement_entries")
}

// توريد أسبوعي لشركة — النظام يسجل ويوثق، والتحويل البنكي ينفذ خارجه
// (مؤتمت مع البنك بترتيب المالك). القيد السالب المرافق في SettlementEntry
// هو ما يصفر رصيد الأمانات، وهذا السجل مرجعه التوثيقي.
model Payout {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Float
  bankReference String? // مرجع التحويل البنكي
  note          String?
  createdAt     DateTime @default(now())

  entries SettlementEntry[]

  @@index([tenantId])
  @@map("payouts")
}

/// لقطة دوريّة لعدد المتصلين بالمنصّة الآن (كل ٥ دقائق) — تُغذّي مؤشّر «الزيارات
/// الحية» الزمنيّ في لوحة المالك. لا عزلَ بشركة: مقياس منصّة إجماليّ للمالك وحده.
model PresenceSnapshot {
  id     String   @id @default(uuid())
  at     DateTime @default(now())
  reps   Int      @default(0) // مناديب متصلون في تلك اللحظة
  admins Int      @default(0) // مستخدمو شركة متصلون في تلك اللحظة
  total  Int      @default(0) // reps + admins

  @@index([at])
  @@map("presence_snapshots")
}

/// عدّاد طلبات API لكل مستخدم في اليوم (بتوقيت الرياض) — يتراكم في الذاكرة ويُفرَغ
/// دورياً (كل دقيقة). يغذّي عرض «استهلاك الطلبات» لكل مستخدم وشركة في لوحة المالك.
/// يشمل الطلبات الخلفية (نبضات الموقع/الحضور) لأنها طلبات API فعليّة. بلا مفاتيح
/// خارجيّة عمداً: يُحفَظ الاستهلاك التاريخيّ حتى لو حُذف المستخدم لاحقاً.
model RequestStat {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String // معرّف SalesRep أو Admin
  kind      String // 'rep' | 'admin'
  day       String // 'YYYY-MM-DD' بتوقيت الرياض
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, userId, day])
  @@index([tenantId, day])
  @@index([day])
  @@map("request_stats")
}

model ProductCategory {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id                   String           @id @default(uuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  barcode              String?
  unit                 String
  basePrice            Float
  taxPct               Float            @default(15)
  image                String? // صورة الصنف (base64 data URL)
  itemCode             String? // كود الصنف للفوترة الإلكترونية (EGS/GS1)
  itemCodeType         String?          @default("EGS") // EGS | GS1
  unitCode             String? // كود الوحدة حسب جدول المزوّد (ETA)
  status               String           @default("ACTIVE") // ACTIVE | INACTIVE
  damagedReturnToStock Boolean          @default(false) // سياسة الصنف: هل يعود مرتجعه التالف لمخزون السيارة؟ (يضبط افتراض المرتجع)
  deletedAt            DateTime? // أرشفة بدل الحذف حين يوجد تاريخ: يختفي من القوائم ويبقى صفه باسمه للفواتير والكشوف القديمة
  categoryId           String?
  category             ProductCategory? @relation(fields: [categoryId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  priceTiers          PriceTier[]
  customerPrices      CustomerPrice[]
  invoiceItems        InvoiceItem[]
  vanLoadItems        VanLoadItem[]
  warehouseEntryItems WarehouseEntryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("products")
}

model PriceTier {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  minQty    Float
  maxQty    Float?
  price     Float
  createdAt DateTime @default(now())

  @@map("price_tiers")
}

model Customer {
  id            String  @id @default(uuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String  @default(cuid())
  name          String
  businessName  String?
  commercialReg String?
  taxNumber     String?
  phone         String
  altPhone      String?
  email         String?
  city          String?
  district      String?
  address       String?
  lat           Float? // موقع العميل على الخريطة (اختياري) — يرفعه المندوب من الميدان
  lng           Float?
  channel       String? // قناة البيع: MT | WHOLESALE | TT | DISCOUNTER | CASH_VAN | ECOMMERCE
  status        String  @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED

  creditLimit    Float @default(0)
  paymentDays    Int   @default(30)
  balance        Float @default(0)
  totalSales     Float @default(0)
  totalCollected Float @default(0)

  // idempotency + تبعية العمل دون اتصال: عميل يُنشأ أوف‑لاين يحمل clientRef، والفاتورة/السند
  // له تشير إليه بـ customerClientRef فيحلّه الخادم إلى id الحقيقي عند الرفع (انظر M5).
  //
  // ⚠️ لا قيد @@unique على clientRef هنا (بخلاف Invoice/Receipt): إضافته على جدول customers
  // الحامل لبيانات فعلية يُفشل `prisma db push` (يطلب --accept-data-loss). فالidempotency
  // للعميل على مستوى التطبيق (findFirst-then-create) — كافٍ لأن المزامنة متسلسلة على جهاز
  // واحد فلا تكرار متزامن. أضِف فهرساً عادياً لتسريع البحث بلا القيد الفريد.
  clientRef       String?
  clientCreatedAt DateTime?

  // عزل العملاء: أي مندوب فتح هذا العميل (توثيق؛ الرؤية نفسها تُحسم بسجلّ الإسناد أدناه).
  // SetNull كي لا يمنع حذفُ المندوب حذفَ/بقاءَ العميل.
  createdBySalesRepId String?
  createdBySalesRep   SalesRep? @relation("CustomerCreatedByRep", fields: [createdBySalesRepId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerPrices CustomerPrice[]
  invoices       Invoice[]
  receipts       Receipt[]
  accountEntries AccountEntry[]
  notifications  Notification[]
  RepVisit       RepVisit[]
  assignments    CustomerAssignment[]
  adminScopes    AdminCustomerScope[]
  paymentLinks   CustomerPaymentLink[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, clientRef]) // فهرس عادي (لا قيد فريد) — يسرّع حلّ customerClientRef
  @@map("customers")
}

// إسناد عميل لمندوب — أساس «عزل العملاء»: عند تفعيل customerIsolationEnabled
// لا يرى المندوب إلا العملاء الذين له معهم سجلّ هنا. العميل الذي يفتحه المندوب
// بنفسه يُنشأ له سجلّ تلقائياً (وللإدارة نزعه). متعدّد‑لمتعدّد: عميل واحد لعدّة مناديب.
model CustomerAssignment {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  // AUTO = أنشأه المندوب بنفسه، MANUAL = أسندته الإدارة (للتمييز في الواجهة فقط)
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())

  @@unique([customerId, salesRepId])
  @@index([tenantId, salesRepId])
  @@index([tenantId, customerId])
  @@map("customer_assignments")
}

model CustomerPrice {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@map("customer_prices")
}

// محتوى الصفحة التعريفية التسويقية والصفحات التابعة (CMS) — صف واحد بمعرّف ثابت "main"
model SiteContent {
  id        String   @id @default("main")
  data      String // JSON كامل لكل محتوى الصفحة التعريفية والصفحات الفرعية
  updatedAt DateTime @default(now()) @updatedAt

  @@map("site_content")
}

model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  // اختياري + SetNull: حذف المندوب يحفظ فاتورته (سجلّ مالي) ويُفرِّغ مرجع المندوب فقط
  salesRepId    String?
  salesRep      SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  type          String    @default("CREDIT") // CASH | CREDIT | RETURN
  status        String    @default("CONFIRMED") // DRAFT | CONFIRMED | CANCELLED
  returnReason  String? // سبب الإرجاع (للمرتجعات): NORMAL | DAMAGED | EXCHANGE
  returnToStock Boolean   @default(true) // هل يعود المرتجع لمخزون السيارة؟ (الأدمن يتحكّم؛ التالف=لا افتراضياً)
  invoiceDate   DateTime  @default(now())
  deliveryDate  DateTime? // تاريخ تسليم المنتج للعميل — يحدده المندوب اختيارياً ولا يُطبع إن غاب
  /// استحقاق الفاتورة. مع خطة أقساط = تاريخ **آخر** قسط (لحظة براءة الذمّة).
  /// معنى واحد لا معنيان: «القسط القادم» يُشتقّ من الجدول الابن ولا يُخزَّن هنا.
  dueDate       DateTime?
  /// خطة السداد — طبقة **جدولة** فوق النوع المحاسبي ولا تبدّله.
  /// null = المنصّة كما هي. "INSTALLMENT" = فاتورة آجلة بجدول أقساط.
  ///
  /// ⚠️ ممنوع إضافة قيمة للتقسيط في `type`: ذاك مفتاح تفريع القيود المحاسبية
  /// وأهليّة توزيع سند القبض (receipts.ts و invoices.ts:/open). قيمةٌ رابعة فيه
  /// تُخرج فاتورة التقسيط من التوزيع الإلزامي ومن فحص الحدّ الائتماني معاً.
  paymentPlan   String?
  notes         String?

  // subtotal و discountAmt **صافيان قبل الضريبة دائما** في كل فواتير المنصة.
  // اما اسعار البنود (items.unitPrice و lineTotal) فتكون شاملة الضريبة متى كان
  // pricesIncludeTax=true — وهي فواتير تطبيق المندوب التي يبقى فيها السعر المعلن
  // للعميل كما هو حرفيا. الافتراضي false يجعل كل الصفوف التاريخية صحيحة بلا ترحيل.
  pricesIncludeTax Boolean @default(false)
  subtotal         Float
  discountPct      Float   @default(0)
  discountAmt      Float   @default(0)
  taxAmt           Float   @default(0)
  total            Float
  paidAmt          Float   @default(0)
  remainingAmt     Float

  // الفوترة الإلكترونية (اعتماد حكومي) — تُملأ عند الإرسال للمزوّد
  einvoiceProvider    String? // zatca | eta | peppol | ttn | none
  einvoiceStatus      String? // generated | submitted | cleared | pending | not_implemented | error
  einvoiceUuid        String? // معرّف الاعتماد (UUID من ETA/Peppol)
  einvoiceQr          String? // حمولة/رابط QR إن وُجد
  einvoiceSubmittedAt DateTime?
  // ZATCA المرحلة الثانية — سلسلة التجزئة والتوقيع
  einvoiceHash        String? // تجزئة SHA-256 (base64) للفاتورة الموقّعة
  einvoicePih         String? // تجزئة الفاتورة السابقة (Previous Invoice Hash)
  einvoiceIcv         Int? // عدّاد الفاتورة (Invoice Counter Value) لكل وحدة EGS
  einvoiceWarnings    String? // تحذيرات الهيئة (JSON) إن وُجدت

  // مفتاح idempotency: UUID يولّده العميل مرّة لكل مستند. عند تكرار الرفع (إعادة محاولة/شبكة
  // متقطّعة) يعيد الخادم الفاتورة القائمة بدل إنشاء مكرّرة. أساس العمل دون اتصال (Outbox).
  clientRef       String?
  clientCreatedAt DateTime? // لحظة الإنشاء على جهاز المندوب (قد تسبق الرفع بساعات)

  // بقايا وحدة المطاعم المحذوفة — حقول يتيمة بقيم افتراضية لا يقرؤها كود
  orderType        String? @default("DINE_IN") // يتيم بعد حذف وحدة المطاعم
  serviceChargeAmt Float   @default(0) // يتيم بعد حذف وحدة المطاعم
  tipAmt           Float   @default(0) // إكرامية (ليست إيراداً ولا ضريبة)
  shiftId          String? // يتيم بعد حذف وحدة المطاعم

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          InvoiceItem[]
  receiptItems   ReceiptInvoice[]
  accountEntries AccountEntry[]
  paymentLinks   CustomerPaymentLink[]
  installments   InvoiceInstallment[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientRef])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // nullable منذ وحدة المطاعم المحذوفة؛ بند التوزيع يملأه دائماً
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  // بقايا وحدة المطاعم المحذوفة — عمودان يتيمان لا يقرؤهما كود ولا يكتبهما.
  // بقيا لأن إسقاط عمود من جدول حيّ يجري في preDeploy بينما النسخة القديمة
  // ما زالت تخدم، فتنكسر استعلاماتها لحظتَها. يُسقطان في نافذة هادئة مستقلّة.
  menuItemId  String?
  orderItemId String?
  unitCost    Float    @default(0) // تكلفة الصنف لحظة البيع (لحساب COGS في M6)
  qty         Float
  unitPrice   Float
  discountPct Float    @default(0)
  discountAmt Float    @default(0)
  taxPct      Float
  taxAmt      Float
  lineTotal   Float

  @@index([menuItemId])
  // كان الجدول مفهرساً على `menuItemId` وحده، بينما **كل** قراءة
  // فاتورة أو تقرير مبيعات أو حساب مخزون سيارة تصل بنودها عبر `invoiceId`،
  // وتجميع «المبيعات حسب الصنف» يمرّ على `productId`.
  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Receipt {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  // اختياري + SetNull: حذف المندوب يحفظ سنده (سجلّ مالي) ويُفرِّغ مرجع المندوب فقط
  salesRepId    String?
  salesRep      SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  receiptDate   DateTime  @default(now())
  amount        Float
  paymentMethod String    @default("CASH") // CASH | BANK_TRANSFER | POS | CHEQUE
  chequeNumber  String?
  bankName      String?
  notes         String?
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED

  // idempotency للعمل دون اتصال (انظر Invoice.clientRef)
  clientRef       String?
  clientCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems   ReceiptInvoice[]
  accountEntries AccountEntry[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientRef])
  @@index([tenantId])
  @@map("receipts")
}

model ReceiptInvoice {
  id        String  @id @default(uuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Float

  @@unique([receiptId, invoiceId])
  @@map("receipt_invoices")
}

model AccountEntry {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  receiptId   String?
  receipt     Receipt? @relation(fields: [receiptId], references: [id])
  type        String // INVOICE_DEBIT | INVOICE_CREDIT | RECEIPT_CREDIT | RECEIPT_DEBIT | ADJUSTMENT_DEBIT | ADJUSTMENT_CREDIT
  debit       Float    @default(0)
  credit      Float    @default(0)
  balance     Float
  description String
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tenantId])
  // قراءة الرصيد الجاري (`accounting.ts: currentBalance`) تقع **داخل معاملة**
  // مع كل فاتورة وسند: `where customerId order by entryDate desc`. بلا هذا
  // الفهرس المركّب تمسح القاعدة الجدولَ تسلسلياً عبر كل الشركات في كل كتابة
  // مالية — وهو أثقل مسار في المنظومة لأنه على الكتابة لا القراءة.
  // وكشف الحساب يقرأ بالترتيب نفسه، فيستفيد منه أيضاً.
  @@index([customerId, entryDate])
  @@map("account_entries")
}

model CompanySettings {
  id                       String  @id @default(uuid())
  tenantId                 String  @unique
  tenant                   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String
  address                  String?
  taxNumber                String?
  commercialReg            String?
  phone                    String?
  email                    String?
  logo                     String? // شعار الشركة (base64 data URL)
  primaryColor             String? // لون الترويسة الأساسي (hex)
  headerStyle              String? @default("classic") // classic | banner | minimal
  // شكل الأرقام في الواجهة والمطبوعات: arabic = ٠١٢٣ · latin = 0123.
  // الافتراضي arabic لأنه سلوك المنصة القائم في الواجهة العربية — فلا تتبدّل
  // شاشة أي شركة قائمة عند التحديث.
  numerals                 String  @default("arabic")
  trackingEnabled          Boolean @default(false) // تفعيل تتبّع مواقع المناديب GPS على مستوى الشركة
  // عزل عملاء المناديب: عند التفعيل لا يرى المندوب إلا العملاء المُسنَدين له (CustomerAssignment).
  // افتراضي false ⇒ كل الشركات القائمة تبقى على سلوكها الحالي عند db push (لا انقطاع).
  customerIsolationEnabled Boolean @default(false)

  // --- التدويل (المرحلة 0): أعمدة إضافية بقيم افتراضية — لا فقد بيانات ---
  countryCode      String  @default("SA") // ISO alpha-2: دولة الشركة
  currency         String  @default("SAR") // عملة الفوترة الفعلية (من الدولة أو من التجاوز)
  currencyOverride String? // تجاوز عملة اختياري (USD | EUR) — الدولة تبقى للضريبة والفوترة
  defaultVatPct    Float   @default(15) // نسبة الضريبة الافتراضية للدولة
  einvoiceProvider String  @default("zatca") // zatca | eta | peppol | ttn | none

  // --- بيانات ربط الفوترة الإلكترونية (تُدخلها كل شركة) — للمزوّدات الحكومية ETA/Peppol/TTN ---
  einvoiceEnabled         Boolean @default(false) // تفعيل الإرسال الحكومي لهذه الشركة
  einvoiceEnv             String  @default("preprod") // preprod | production
  einvoiceClientId        String? // معرّف العميل (من بوابة المزوّد/الوسيط)
  einvoiceClientSecret    String? // السرّ (يُدخله العميل — لا يُعرض بعدها)
  einvoiceActivityCode    String? // كود النشاط (ETA)
  einvoiceBranchCode      String? // كود الفرع/الموقع
  einvoiceIntermediaryUrl String? // رابط الوسيط/المُجمِّع المعتمد (اختياري)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

/// وحدة توليد الفوترة الإلكترونية (EGS) لـZATCA المرحلة الثانية — مفاتيح وشهادات الربط لكل شركة.
/// المفاتيح والأسرار حسّاسة: تُخزَّن مشفّرةً على مستوى التطبيق (Z0ب).
model ZatcaEgs {
  id               String    @id @default(uuid())
  tenantId         String    @unique
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  environment      String    @default("production") // sandbox | simulation | production
  egsSerialNumber  String    @default("") // 1-<solution>|2-<model>|3-<serial>
  privateKeyPem    String? // مفتاح EC secp256k1 الخاصّ (حسّاس)
  csrPem           String? // طلب توقيع الشهادة (CSR)
  complianceCsid   String? // binarySecurityToken من واجهة الامتثال
  complianceSecret String?
  complianceReqId  String? // requestID لاجتياز فحوص الامتثال
  productionCsid   String? // شهادة الإنتاج (binarySecurityToken)
  productionSecret String?
  csidIssuedAt     DateTime?
  csidExpiresAt    DateTime?
  lastIcv          Int       @default(0) // آخر عدّاد فاتورة مُسند لهذه الوحدة
  lastPih          String? // تجزئة آخر فاتورة (لتسلسل PIH)
  status           String    @default("not_started") // not_started | csr_ready | compliance | ready | error
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("zatca_egs")
}

model ErpIntegration {
  id                String    @id @default(uuid())
  tenantId          String    @unique
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled           Boolean   @default(false)
  provider          String    @default("CUSTOM") // CUSTOM | ODOO | SAP | ZOHO | OTHER
  baseUrl           String?
  authType          String    @default("NONE") // NONE | API_KEY | BEARER | BASIC
  apiKey            String?
  bearerToken       String?
  basicUsername     String?
  basicPassword     String?
  customersEndpoint String?
  productsEndpoint  String?
  invoicesEndpoint  String?
  receiptsEndpoint  String?
  syncCustomers     Boolean   @default(true)
  syncProducts      Boolean   @default(true)
  syncInvoices      Boolean   @default(true)
  syncReceipts      Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@map("erp_integrations")
}

model ErpSyncLog {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource   String // customers | products | invoices | receipts | connection
  direction  String    @default("OUTBOUND")
  status     String // SUCCESS | FAILED
  count      Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId])
  @@index([resource])
  @@map("erp_sync_logs")
}

/// تكامل بترو آب — ربط اختياريّ لكل شركة حسب حاجتها (وقود/صيانة/غسيل).
/// المفاتيح تُدخلها الشركة من إعداداتها (مفاتيح حسابها لدى بترو آب) ولا تُعاد للواجهة بعد الحفظ.
model PetroappIntegration {
  id           String    @id @default(uuid())
  tenantId     String    @unique
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled      Boolean   @default(false)
  baseUrl      String    @default("https://api.petroapp.com") // يُعدَّل حين تسلّم بترو آب الوثائق الرسمية
  apiKey       String?
  // الخدمات المفعّلة «حسب احتياج» الشركة — كل خدمة تُزامَن فقط إن فُعّلت
  syncFuel     Boolean   @default(true)
  syncService  Boolean   @default(true)
  syncWash     Boolean   @default(true)
  status       String    @default("PENDING") // PENDING | OK | ERROR
  lastSyncAt   DateTime?
  lastError    String?
  // كاش شبكة المحطات (قائمة كبيرة تتغيّر نادراً) — تتجدّد كل ٢٤ ساعة
  stationsJson String?
  stationsAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicles     PetroappVehicle[]
  delegates    PetroappDelegate[]
  transactions FuelTransaction[]

  @@map("petroapp_integrations")
}

/// مركبات الشركة لدى بترو آب — تُزامَن ثم تُربط يدوياً بالمناديب لتُنسب مصاريفها.
model PetroappVehicle {
  id            String              @id @default(uuid())
  tenantId      String
  integrationId String
  integration   PetroappIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String
  plate         String?
  model         String?
  salesRepId    String? // ربط مركبة ↔ مندوب (يدويّ من شاشة المطابقة)
  balance       Float? // رصيد رحلة/ميزانية من /updated_trips إن توفّر
  balanceAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, salesRepId])
  @@map("petroapp_vehicles")
}

/// سائقو بترو آب (delegates) — يُربطون بالمناديب فتُنسب فواتيرهم تلقائياً.
model PetroappDelegate {
  id            String              @id @default(uuid())
  tenantId      String
  integrationId String
  integration   PetroappIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String
  name          String?
  phone         String?
  salesRepId    String?
  balance       Float?
  balanceAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, externalId])
  @@index([tenantId, salesRepId])
  @@map("petroapp_delegates")
}

/// فواتير بترو آب (وقود/صيانة/غسيل) — إزالة التكرار ببصمة محتوى **داخل الشركة**
/// (درس العزل: البصمة العالمية باب خلفيّ يسرّب وجود سجلّ شركةٍ لأخرى).
model FuelTransaction {
  id                 String              @id @default(uuid())
  tenantId           String
  integrationId      String
  integration        PetroappIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  kind               String // FUEL | SERVICE | WASH
  externalId         String?
  contentHash        String
  vehicleExternalId  String?
  delegateExternalId String?
  salesRepId         String? // يُحلّ عند المزامنة من روابط المركبات/السائقين ويُعاد حلّه عند تغيير الربط
  stationName        String?
  liters             Float?
  amount             Float               @default(0)
  odometer           Int?
  occurredAt         DateTime
  raw                String? // لقطة JSON خام للفاتورة كما وصلت (تشخيص ومطابقة مستقبلية)
  createdAt          DateTime            @default(now())

  @@unique([tenantId, contentHash])
  @@index([tenantId, occurredAt])
  @@index([tenantId, salesRepId, occurredAt])
  @@map("fuel_transactions")
}

/// تكامل هاتف (أرقام العمل) — إعدادات المزوّد لكل شركة على نمط ErpIntegration.
/// provider=manual: الشركة تُدخل أرقامها يدوياً بلا مزوّد (صفر كلفة) — وهو وضع M0 الافتراضي.
/// provider=hatif: مفاتيح OAuth لحساب الشركة لدى هاتف (api.voxa.sa) — لا تُعاد للواجهة بعد الحفظ.
model TelephonyIntegration {
  tenantId      String    @id
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider      String    @default("manual") // manual | hatif
  baseUrl       String    @default("https://api.voxa.sa")
  clientId      String?
  clientSecret  String?
  // سرّ الويبهوك في المسار نفسه (عقد هاتف بلا توقيع HMAC موثّق) — عشوائي لكل شركة
  webhookSecret String    @default(uuid())
  status        String    @default("PENDING") // PENDING | OK | ERROR
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("telephony_integrations")
}

/// رقم عمل مؤسسي — كيان يملكه المستأجر لا المندوب: يُسنَد ويُحرَّر، وعلاقة العميل
/// تبقى عند الشركة بعد استقالة المندوب (جوهر الميزة).
model WorkChannel {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  e164              String // ‎+9665XXXXXXXX — مُطبَّع عند الكتابة دائماً
  label             String? // «الرياض ١» · «مندوب القصيم»
  provider          String    @default("manual") // manual | hatif
  providerChannelId String? // channel.id عند هاتف — يُمرَّر في كل إرسال
  kind              String    @default("voice") // voice | whatsapp | both
  isActive          Boolean   @default(true)
  assignedRepId     String?   @unique @map("assigned_rep_id") // null = في المخزون حرّاً؛ فريد ⇒ مندوب واحد لقناة واحدة (المندوب لمستأجر واحد فالفريد العالمي يكافئ المركّب)
  assignedRep       SalesRep? @relation(fields: [assignedRepId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  calls             CallLog[]

  @@unique([tenantId, e164])
  @@index([tenantId, isActive])
  @@map("work_channels")
}

/// سجلّ مكالمة من ويبهوك المزوّد — salesRepId لقطة وقت الحدث (لا تتغيّر بإعادة
/// إسناد القناة لاحقاً)، والقيد الفريد على providerCallId حصانة تكرار الويبهوك.
model CallLog {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workChannelId  String?
  workChannel    WorkChannel? @relation(fields: [workChannelId], references: [id], onDelete: SetNull)
  salesRepId     String?
  customerId     String?
  direction      String // IN | OUT | MISSED
  fromE164       String
  toE164         String
  startedAt      DateTime
  durationSec    Int          @default(0)
  recordingUrl   String? // رابط عند المزوّد — لا نخزّن الصوت عندنا (تقليل سطح البيانات)
  transcript     String?
  aiSummary      String?
  providerCallId String
  createdAt      DateTime     @default(now())

  @@unique([tenantId, providerCallId])
  @@index([tenantId, salesRepId, startedAt])
  @@index([tenantId, customerId, startedAt])
  @@map("call_logs")
}

model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       String // CREDIT_LIMIT_EXCEEDED | DISCOUNT_LIMIT_EXCEEDED | OVERDUE_PAYMENT | INVOICE_CANCELLED | PRICE_MODIFIED | RECEIPT_CANCELLED
  title      String
  body       String
  salesRepId String?
  salesRep   SalesRep? @relation(fields: [salesRepId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  isRead     Boolean   @default(false)
  data       String? // JSON كنص
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("notifications")
}

// تحميل بضاعة لسيارة المندوب — حركة مخزون (LOAD=تحميل، UNLOAD=تنزيل للمستودع، ADJUST=تسوية)
model VanLoad {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id])
  type       String   @default("LOAD") // LOAD | UNLOAD | ADJUST
  note       String?
  createdBy  String? // "REP" | "ADMIN" — من سجّل الحركة
  createdAt  DateTime @default(now())

  items VanLoadItem[]

  @@index([tenantId])
  @@index([salesRepId])
  @@map("van_loads")
}

model VanLoadItem {
  id        String  @id @default(uuid())
  vanLoadId String
  vanLoad   VanLoad @relation(fields: [vanLoadId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Float // موجب للتحميل/التسوية الزائدة، يُفسَّر حسب نوع VanLoad

  // ما اقترحه المحرّك وقت هذا التحميل. اختياري وإضافي: بلا جدول جديد.
  // بدونه لا يوجد دليل قيمة لاحقاً — مقارنة «المقترَح مقابل المُباع مقابل
  // المرتجع» هي البرهان الوحيد على أن الاقتراح يستحقّ الثقة، وتسجيلها
  // لاحقاً يعني فقد كل الأشهر التي مضت.
  suggestedQty Float?

  // **التنبّؤ اليومي** وقت التحميل (expected من محرّك الاقتراح) — مرجعُ قياس
  // الدقّة الوحيد. suggestedQty كمية تعبئة (بعد الهامش وخصم ما في السيارة)
  // وقياسُها بدل التنبّؤ يقلب النتيجة: كل مندوب لا يُفرغ سيارته يظهر «نقصاً»
  // موهوماً فتوصي القياسات برفع الهامش وتُملأ السيارات ببضاعة راكدة.
  expectedQty Float?

  @@index([vanLoadId])
  @@map("van_load_items")
}

/// وارد مخزون الشركة (المستودع المركزيّ) — استلام/شراء أو تسوية. مرتبطٌ بمخزون
/// السيارات: تحميل السيارة يخرج من المستودع، والتنزيل (UNLOAD) يعود إليه.
model WarehouseEntry {
  id        String               @id @default(uuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String               @default("RECEIVE") // RECEIVE (وارد/شراء) | ADJUST (تسوية)
  note      String?
  supplier  String? // المورّد (اختياري، للوارد)
  createdBy String? // اسم المستخدم الذي سجّل الحركة
  items     WarehouseEntryItem[]
  createdAt DateTime             @default(now())

  @@index([tenantId, createdAt])
  @@map("warehouse_entries")
}

model WarehouseEntryItem {
  id        String         @id @default(uuid())
  entryId   String
  entry     WarehouseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  qty       Float // موجب للوارد؛ + أو − للتسوية
  // تكلفة شراء الوحدة **صافيةً قبل الضريبة** — معنى واحد لا معنيان:
  // ما يُدخله المستخدم شاملاً الضريبة يُردّ إلى صافيه في الخادم قبل الحفظ.
  // اختياريّ: الاستلام قد يُسجَّل قبل وصول فاتورة المورّد، ولا يُعطَّل لأجلها.
  unitCost  Float? // للوارد (RECEIVE) فقط

  @@index([productId])
  @@map("warehouse_entry_items")
}

// نقطة موقع GPS للمندوب — سجلّ زمني لرسم خطّ السير ومعرفة الموقع الحالي
model RepLocation {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float? // دقة الموقع بالأمتار
  speed      Float? // السرعة م/ث إن توفّرت
  capturedAt DateTime // وقت التقاط الموقع على جهاز المندوب
  createdAt  DateTime @default(now())

  @@index([tenantId, salesRepId, capturedAt])
  @@map("rep_locations")
}

// زيارة ميدانية يسجّلها المندوب عند العميل — ملاحظة نصية + صور (رفوف/عروض) + موقع GPS.
// تُلتقط أوف‑لاين وتُرفع عبر الصفّ الصادر (clientRef = idempotency، انظر العمل دون اتصال).
model RepVisit {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  note       String? // ملاحظة نصية عن الزيارة
  lat        Float? // موقع المندوب لحظة تسجيل الزيارة (إثبات الوصول)
  lng        Float?
  clientRef  String? // مفتاح idempotency للالتقاط دون اتصال
  createdAt  DateTime @default(now())

  // مؤقّت الزيارة: مدّة مكوث المندوب في ملفّ العميل (من ضغط أيقونة البدء حتى
  // الخروج). كلّها اختيارية وإضافية — زيارة الملاحظة القديمة تبقى بلا مدّة.
  // المدّة تُحسب على الخادم من الطابعين (services/visitDuration.ts) لا من رقم
  // العميل، وتُقصّ عند سقف معقول ضدّ التوكن المنسيّ.
  startedAt   DateTime? // لحظة بدء المؤقّت
  endedAt     DateTime? // لحظة الخروج من ملفّ العميل
  durationSec Int? // المدّة المعتمَدة بالثواني (null = زيارة ملاحظة بلا توقيت)

  photos VisitPhoto[]

  @@unique([tenantId, clientRef])
  @@index([tenantId, salesRepId, createdAt])
  @@index([tenantId, customerId])
  @@map("rep_visits")
}

// صورة زيارة (رفّ/منتج/عرض) — تُخزَّن base64 (مضغوطة على العميل) في جدول منفصل
// كي لا تُحمَّل في قوائم الزيارات إلا عند الطلب.
model VisitPhoto {
  id        String   @id @default(uuid())
  visitId   String
  visit     RepVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  data      String // data URL: data:image/jpeg;base64,...
  createdAt DateTime @default(now())

  @@index([visitId])
  @@map("visit_photos")
}

// استلام تحصيل من المندوب — كل مرّة يسلّم فيها المندوب نقدًا للإدارة يُسجَّل هنا.
// رصيد التحصيل لدى المندوب = مجموع سنداته النشطة − مجموع ما سُجّل هنا من استلامات.
model RepSettlement {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  amount     Float
  note       String?
  createdBy  String? // اسم/معرّف الأدمن الذي استلم
  settledAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, salesRepId])
  @@map("rep_settlements")
}

// جلسة حضور: تُمدَّد بنبضات القلب من تطبيق المندوب أثناء فتحه، لحساب ساعات العمل
// (الوقت الذي كان فيه المندوب متصلاً وفاتحاً التطبيق) — مستقلّة عن تتبّع GPS.
model RepSession {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastBeatAt DateTime // آخر نبضة = نهاية الجلسة الحالية
  createdAt  DateTime @default(now())

  @@index([tenantId, salesRepId, startedAt])
  @@map("rep_sessions")
}

// ============================================================================
// العملاء المحتملون (Leads) — على مستوى المنصّة (مالك المنصّة / السوبر أدمن)
// شركات توزيع/جملة حول العالم قد تشترك في Field Sales. مستقلة عن أي Tenant.
// ============================================================================

// عميل محتمل واحد (شركة) — تُجمع من الخرائط/المصادر العامة أو يدوياً
model Lead {
  id          String  @id @default(uuid())
  name        String // اسم النشاط/الشركة
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String? // اسم الدولة (للعرض)
  countryCode String? // ISO-3166 alpha-2 (للتجميع والفلترة)
  category    String? // نوع النشاط (تجارة جملة، موزّع...)
  lat         Float?
  lng         Float?
  mapsUrl     String? // رابط الموقع على الخريطة

  source   String  @default("manual") // manual | csv | osm | google | social | api
  sourceId String? @unique // مفتاح إزالة التكرار لكل مصدر (مثل "osm:node/123")

  // خط أنابيب المبيعات
  stage             String    @default("NEW") // NEW | CONTACTED | QUALIFIED | PROPOSAL | WON | LOST
  score             Int? // ملاءمة 1-10 (تأهيل آلي/يدوي)
  scoreNote         String?
  assignedTo        String? // معرّف/اسم مسؤول المتابعة (سوبر أدمن)
  convertedTenantId String? // عند التحويل لمشترك فعلي
  notes             String?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?

  // انسحاب من مراسلة واتساب — يُضبط تلقائياً عند ردّ العميل بكلمة إلغاء/stop.
  // مُستثنى من كل استهداف لاحق (سياسة واتساب + حماية تقييم جودة الرقم).
  waOptOut Boolean @default(false)

  // نوع الهاتف: true جوّال · false أرضي مؤكَّد · null غير معروف (لا يُقصى).
  // أرقام الليدز المصيدة أغلبها أرضي (145 من 183 محاولة إرسال قياساً) — والأرضي
  // يُهدر الحصّة ويُضعف سمعة الرقم. لا يُحذف العميل: يُستبعد من استهداف واتساب فقط.
  phoneIsMobile Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  waMessages WaMessage[]

  @@index([stage])
  @@index([countryCode])
  @@index([source])
  @@index([nextFollowUpAt])
  @@map("leads")
}

// سجلّ رسائل واتساب (صادر/وارد) — يغذّي الحدّ اليومي وتتبّع التسليم/القراءة ومطابقة الردود.
// حالات التسليم تصل عبر webhook من Meta وتُحدَّث على waId.
model WaMessage {
  id          String  @id @default(uuid())
  waId        String? @unique // معرّف رسالة واتساب (wamid) — مفتاح تحديث الحالة من الـwebhook
  leadId      String?
  lead        Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  phone       String // الرقم مطبَّعاً (أرقام فقط) — مفتاح مطابقة الردود الواردة
  direction   String  @default("OUT") // OUT | IN
  body        String? // نصّ الرسالة (أو نصّ الردّ الوارد)
  template    String? // اسم القالب المعتمد (للصادر بوضع القالب)
  status      String  @default("SENT") // SENT | DELIVERED | READ | FAILED | RECEIVED
  error       String?
  // هل أكّد واتساب التسليم فعلاً (ACK≥1)؟ الكود القديم كان يُعلّم SENT بمجرّد أن يعود
  // sendMessage — وهو يعود قبل التسليم — فوُجدت رسائل «ناجحة» لم تخرج قطّ.
  // false على رسالة SENT قديمة = تحتاج مصالحة مع واتساب.
  ackVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([phone])
  @@index([createdAt])
  @@map("wa_messages")
}

// سجلّ نشاط/متابعة على عميل محتمل (مكالمة، ملاحظة، تغيير مرحلة...)
model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // NOTE | CALL | EMAIL | MEETING | STAGE_CHANGE | SCORE | IMPORT
  content   String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// سجلّ عملية بحث آلي (لتتبّع مصادر الجمع وتجنّب التكرار وعرض التاريخ)
model LeadSearch {
  id        String   @id @default(uuid())
  provider  String // osm | google
  query     String // نوع النشاط المبحوث عنه
  country   String?
  city      String?
  status    String   @default("done") // running | done | failed
  found     Int      @default(0) // إجمالي النتائج من المصدر
  imported  Int      @default(0) // الجدد المُضافون بعد إزالة التكرار
  error     String?
  createdBy String?
  createdAt DateTime @default(now())

  @@map("lead_searches")
}

// ============================================================================
// تحليلات زيارات الموقع التعريفي — على مستوى المنصّة (مالك المنصّة / السوبر أدمن)
// تُسجَّل زيارة لكل تحميل صفحة عامّة، مع تحديد الدولة/المدينة من IP (بدون تخزين IP خام).
// ============================================================================
model Visit {
  id           String   @id @default(uuid())
  path         String // مسار الصفحة (/ , /blog , /en ...)
  lang         String? // ar | en
  referrer     String? // الرابط المُحيل الكامل
  referrerHost String? // نطاق المُحيل (google.com ...) أو null للزيارة المباشرة
  country      String?
  countryCode  String? // ISO alpha-2
  region       String?
  city         String?
  ipHash       String? // بصمة IP مجزّأة (لعدّ الزوّار الفريدين دون تخزين IP الخام)
  userAgent    String?
  isBot        Boolean  @default(false)
  createdAt    DateTime @default(now())

  // --- طبقة الإسناد التسويقي: كلها اختيارية (تغيير إضافي بحت، بلا فقد بيانات) ---
  // هوية مجهولة ثابتة (كوكي طرف أول) وجلسة — لربط الزيارات ببعضها دون بيانات شخصية
  anonId       String?  @db.VarChar(40)
  sessionId    String?  @db.VarChar(40)
  // وسوم الحملة (قاموس مغلق يُطبَّع على الخادم؛ أي قيمة خارجه ⇒ other)
  utmSource    String?  @db.VarChar(64)
  utmMedium    String?  @db.VarChar(64)
  utmCampaign  String?  @db.VarChar(96)
  utmContent   String?  @db.VarChar(96)
  utmTerm      String?  @db.VarChar(96)
  // قناة مشتقّة على الخادم: ai_generative | organic | referral | direct | email | social
  channel      String?  @db.VarChar(24)
  aiEngine     String?  @db.VarChar(24) // chatgpt | perplexity | copilot | gemini | claude
  // أول لمسة (تُثبَّت مرّة ولا تُدهس) — تُرسل من الكوكي مع كل زيارة
  firstSource  String?  @db.VarChar(64)
  firstMedium  String?  @db.VarChar(64)
  firstLanding String?  @db.VarChar(180)
  // واتساب: مرجع الصفحة التي أطلقت النقرة + رمز يربط المحادثة بالزيارة
  waRef        String?  @db.VarChar(48)
  waCode       String?  @db.VarChar(16)
  waClicked    Boolean? // true = صفّ نقرة واتساب لا مشاهدة صفحة
  contentType  String?  @db.VarChar(24) // landing | blog | tool | pricing | sector | compare

  @@index([createdAt])
  @@index([countryCode])
  @@index([referrerHost])
  @@index([anonId])
  @@index([utmSource, utmMedium])
  @@index([waRef])
  @@index([channel])
  @@map("visits")
}

