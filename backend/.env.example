DATABASE_URL="postgresql://user:password@localhost:5432/dsd_db"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# الفيديوهات الترويجية (لوحة المالك)
# HEYGEN_API_KEY (أساسي): heygen.com → Settings → Subscriptions & API → API Token
HEYGEN_API_KEY=""
# اختياري — يُحدَّدان تلقائياً من حسابك إن تُركا فارغين
HEYGEN_AVATAR_ID=""
HEYGEN_VOICE_ID=""
# GOOGLE_TTS_KEY (اختياري): console.cloud.google.com → تفعيل Cloud Text-to-Speech API → Credentials → API Key
GOOGLE_TTS_KEY=""
# صوت TTS الافتراضي (اختياري): ar-XA-Wavenet-B ذكر / ar-XA-Wavenet-A أنثى
GOOGLE_TTS_VOICE=""

# إشعارات آيفون (APNs) لتطبيق المندوب — بلا الثلاثة الأولى الإرسال خامل والاشتراكات باقية (services/apnsPush.ts)
# APNS_KEY_P8: نصّ ملف ‎.p8‎ (PEM) أو base64 له في سطرٍ واحد — يلصقه المالك في Render ولا يُحفظ في المستودع
APNS_KEY_P8=""
# APNS_KEY_ID: معرّف المفتاح (عشرة أحرف) · APNS_TEAM_ID: رقم الفريق (عشرة أحرف)
APNS_KEY_ID=""
APNS_TEAM_ID=""
# APNS_TOPIC (اختياري): معرّف حزمة التطبيق — net.fieldsa.rep افتراضاً
APNS_TOPIC=""
