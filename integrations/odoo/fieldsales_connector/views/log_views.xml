<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fieldsales_sync_log_tree" model="ir.ui.view">
    <field name="name">fieldsales.sync.log.tree</field>
    <field name="model">fieldsales.sync.log</field>
    <field name="arch" type="xml">
      <tree string="Field Sales sync log" create="false" edit="false"
            decoration-danger="error_count &gt; 0">
        <field name="create_date" string="Received at"/>
        <field name="resource"/>
        <field name="received"/>
        <field name="created_count"/>
        <field name="updated_count"/>
        <field name="error_count"/>
        <field name="exported_at" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_fieldsales_sync_log_form" model="ir.ui.view">
    <field name="name">fieldsales.sync.log.form</field>
    <field name="model">fieldsales.sync.log</field>
    <field name="arch" type="xml">
      <form string="Field Sales sync" create="false" edit="false">
        <sheet>
          <group>
            <group>
              <field name="resource"/>
              <field name="received"/>
              <field name="exported_at"/>
            </group>
            <group>
              <field name="created_count"/>
              <field name="updated_count"/>
              <field name="error_count"/>
            </group>
          </group>
          <separator string="Errors (first 20)"/>
          <field name="errors" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_fieldsales_sync_log" model="ir.actions.act_window">
    <field name="name">Field Sales sync log</field>
    <field name="res_model">fieldsales.sync.log</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_fieldsales_sync_log"
            name="Field Sales sync log"
            parent="account.menu_finance_configuration"
            action="action_fieldsales_sync_log"
            sequence="95"/>

</odoo>
