<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- شاشة التحصيل بالبطاقة: سمة Material غير شفافة، لأن واجهة NearPay (نافذة سفلية وأجزاء) تُعرض فوقها وقد تشترط سمة
         AppCompat/Material. الألوان من هوية التطبيق (colorPrimary وbackgroundColor يولّدهما app/build.gradle) -->
    <style name="Theme.FieldSales.CardPay" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>

    <!-- شاشة جسر الطباعة (PrintActivity): السمة نفسها غير شفافة عمداً — تغطي المتصفح فيتوقف ويطلق visibilitychange،
         وبه تعرف الصفحة أن الأمر سُلِّم إلى التطبيق -->
    <style name="Theme.FieldSales.Print" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>

    <!-- شاشة بدء التتبّع الخلفي وإيقافه (TrackActivity): غير شفافة عمداً كشاشة الطباعة — تغطي المتصفح فيتوقف ويطلق
         visibilitychange فتعرف الصفحة أن البدء سُلِّم، ويرى المندوب لحظةً أن التسجيل بدأ أو توقف -->
    <style name="Theme.FieldSales.Track" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>
</resources>
